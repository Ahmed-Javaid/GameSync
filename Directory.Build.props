<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- R20: dependency versions are pinned in packages.lock.json. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Release zips are published for 64-bit Windows (tools/release/pack.ps1); every restore resolves for it too, so the
         lock files pin its native packages and don't change between a build and a release. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Product>GameSync</Product>
    <!-- Milestone 5's builds are 0.5, Milestone 6's 0.6 (0.6.0 the first installer for friends, 0.6.1 with first run
         reworked, both 18 Oct 2026); v1.0 is the release on GitHub. Release zips add the date (tools/release/pack.ps1). An
         update installs only over a lower version, so a build that leaves this PC gets a version of its own. -->
    <VersionPrefix>0.6.1</VersionPrefix>
  </PropertyGroup>
</Project>
