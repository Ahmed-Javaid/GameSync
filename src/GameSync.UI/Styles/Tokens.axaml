<!-- The design system's fixed tokens (design/system/tokens.json): spacing, radii, sizes and type. Colours come from ThemeService. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Double x:Key="space-1">4</x:Double>
  <x:Double x:Key="space-2">8</x:Double>
  <x:Double x:Key="space-3">12</x:Double>
  <x:Double x:Key="space-4">16</x:Double>
  <x:Double x:Key="space-5">20</x:Double>
  <x:Double x:Key="space-6">24</x:Double>
  <x:Double x:Key="space-8">32</x:Double>

  <CornerRadius x:Key="radius-sm">6</CornerRadius>
  <CornerRadius x:Key="radius-md">10</CornerRadius>
  <CornerRadius x:Key="radius-lg">16</CornerRadius>
  <CornerRadius x:Key="radius-pill">999</CornerRadius>

  <x:Double x:Key="rail-width">64</x:Double>
  <x:Double x:Key="control-height">40</x:Double>
  <x:Double x:Key="row-height">36</x:Double>

  <!-- Onest and JetBrains Mono ship inside the app; Windows' own faces stand in only if they can't load. -->
  <FontFamily x:Key="font-sans">avares://GameSync.UI/Assets/Fonts#Onest, Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="font-mono">avares://GameSync.UI/Assets/Fonts#JetBrains Mono, Cascadia Mono, Consolas</FontFamily>
</ResourceDictionary>
