<!-- The type styles (design/system/tokens.json → type), as classes on TextBlock: hero-title, page-title, card-title, body,
     body-strong, caption, overline for the Launcher; mono-stat, mono-body, mono-small for the Console. And ink colours. -->
<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="using:GameSync.UI.Controls">
  <!-- The current tab's or section's icon takes the secondary colour (control themes can't reach into their content). -->
  <Style Selector="ListBoxItem:selected c|GsIcon.selectable">
    <Setter Property="Foreground" Value="{DynamicResource secondary}" />
  </Style>

  <!-- A theme card's ring: bg-400 on hover, primary when chosen. -->
  <Style Selector="ListBoxItem:pointerover Border.theme-ring">
    <Setter Property="BorderBrush" Value="{DynamicResource bg-400}" />
  </Style>
  <Style Selector="ListBoxItem:selected Border.theme-ring">
    <Setter Property="BorderBrush" Value="{DynamicResource primary}" />
  </Style>

  <!-- Settings rows after the first get a hairline above; so do rows a list adds after one, which count as first in their own place. -->
  <Style Selector="c|GsSettingsRow:nth-child(n+2), c|GsSettingsRow.after">
    <Setter Property="BorderBrush" Value="{DynamicResource line-100}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>

  <!-- A row named by something in mono: a PC, a folder. -->
  <Style Selector="c|GsSettingsRow.mono /template/ TextBlock#PART_Title">
    <Setter Property="FontFamily" Value="{DynamicResource font-mono}" />
  </Style>

  <!-- A note about something that went wrong, in warn. -->
  <Style Selector="c|GsNote.warn">
    <Setter Property="Foreground" Value="{DynamicResource warn}" />
  </Style>

  <!-- Console table cells: uppercase mono headers with tracking, mono cells, numbers right-aligned, paths muted. -->
  <Style Selector="TextBlock.th">
    <Setter Property="FontFamily" Value="{DynamicResource font-mono}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="LineHeight" Value="16" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LetterSpacing" Value="0.88" />
    <Setter Property="Foreground" Value="{DynamicResource ink-faint}" />
    <Setter Property="Margin" Value="12,10" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.td">
    <Setter Property="FontFamily" Value="{DynamicResource font-mono}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Margin" Value="12,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="TextBlock.num">
    <Setter Property="TextAlignment" Value="Right" />
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>
  <Style Selector="TextBlock.path">
    <Setter Property="Foreground" Value="{DynamicResource ink-muted}" />
  </Style>

  <!-- Menus (design system → Menu): 36px rows on radius-sm inside the dialog's surface; their icons in ink-muted. -->
  <Style Selector="MenuItem">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="MenuItem c|GsIcon">
    <Setter Property="Foreground" Value="{DynamicResource ink-muted}" />
  </Style>
  <Style Selector="MenuItem:checked c|GsIcon">
    <Setter Property="Foreground" Value="{DynamicResource secondary}" />
  </Style>

  <!-- SearchField: a 40px text field on radius-md with the search icon in front (design system → SearchField). -->
  <Style Selector="TextBox.search">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="8,0,4,0" />
  </Style>

  <!-- Every window: the ground, ink and the sans face, which everything inside inherits. -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource bg-100}" />
    <Setter Property="Foreground" Value="{DynamicResource ink}" />
    <Setter Property="FontFamily" Value="{DynamicResource font-sans}" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="TextBlock.hero-title">
    <Setter Property="FontSize" Value="32" />
    <Setter Property="LineHeight" Value="38" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.page-title">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="LineHeight" Value="30" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.card-title">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="LineHeight" Value="24" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TextBlock.body-strong">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- A field's name above it in a dialog, as the design system's gs-own-label -->
  <Style Selector="TextBlock.field-label">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="16" />
  </Style>
  <!-- 0.12em, as the design system's overline -->
  <Style Selector="TextBlock.overline">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="LineHeight" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="1.32" />
  </Style>
  <Style Selector="TextBlock.mono-stat">
    <Setter Property="FontFamily" Value="{DynamicResource font-mono}" />
    <Setter Property="FontSize" Value="28" />
    <Setter Property="LineHeight" Value="32" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TextBlock.mono, TextBlock.mono-body">
    <Setter Property="FontFamily" Value="{DynamicResource font-mono}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="20" />
  </Style>
  <!-- A fact that's a path, a build or an option -->
  <Style Selector="TextBlock.mono-fact">
    <Setter Property="FontFamily" Value="{DynamicResource font-mono}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.mono-small">
    <Setter Property="FontFamily" Value="{DynamicResource font-mono}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="18" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource ink-muted}" />
  </Style>
  <Style Selector="TextBlock.faint">
    <Setter Property="Foreground" Value="{DynamicResource ink-faint}" />
  </Style>
  <!-- A page's own scroller (KAN-71): it reaches into the page's 24px right gutter and pads its content back, so its 12px
       bar sits in the middle of the gutter, its thumb 9px clear of the cards on one side and of the window's edge on the
       other (the owner, 1 Oct 2026), and the content stays in line with the page's top bar. -->
  <Style Selector="ScrollViewer.page">
    <Setter Property="Margin" Value="0,0,-18,0" />
    <Setter Property="Padding" Value="0,0,18,0" />
  </Style>
</Styles>
