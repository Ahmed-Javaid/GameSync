<!-- The Launcher register: game tiles, the hero banner and its chip (design/system/components/bundle.css). -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:GameSync.UI.Controls"
                    xmlns:sys="using:System">

  <!-- GameTile: 2:3 art, a status badge unless its saves are fine (then a small mark, KAN-48), the name and a meta line; a title cover when there's no art -->
  <ControlTheme x:Key="{x:Type c:GsGameTile}" TargetType="c:GsGameTile">
    <!-- Avalonia 12 clips a templated control to its bounds, which cut the rings outside the art on three sides -->
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Width" Value="160" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="FocusAdorner" Value="{DynamicResource RoundedFocus}" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Spacing="8" Background="{TemplateBinding Background}">
          <c:AspectPanel Ratio="1.5">
            <Panel>
            <Border Name="PART_Art" CornerRadius="16" ClipToBounds="True" Background="{DynamicResource bg-300}">
              <Panel>
                <c:GsCoverImage Source="{TemplateBinding Art}" />
                <Panel Name="PART_TitleCover">
                  <TextBlock Text="{TemplateBinding Initial}" FontSize="128" LineHeight="128" FontWeight="Bold" Foreground="{DynamicResource bg-400}"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-18" />
                  <TextBlock Text="{TemplateBinding Title}" Margin="10" FontSize="15" LineHeight="19" FontWeight="SemiBold" TextWrapping="Wrap"
                             MaxLines="4" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ink}" />
                </Panel>
                <c:GsStatusBadge Classes="art" Status="{TemplateBinding Status}" Label="{TemplateBinding StatusLabel}" IsVisible="{TemplateBinding ShowsStatus}"
                                 HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8" />
                <!-- Saves fine: a check in the ok colour on the art's deep tint, its words in the tooltip -->
                <Border Name="PART_Mark" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource ok-art}" IsVisible="{TemplateBinding ShowsMark}"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8" ToolTip.Tip="{TemplateBinding MarkLabel}">
                  <c:GsIcon Icon="check" Size="14" StrokeWidth="2.5" Foreground="{DynamicResource ok}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Panel>
            </Border>
            <!-- Glossy's 1px ring just outside the art (clear in Solid), and the hover outline 2px further out, as in the design system -->
            <Border CornerRadius="17" Margin="-1" BorderThickness="1" BorderBrush="{DynamicResource edge-art}" IsHitTestVisible="False" />
            <Border Name="PART_Hover" CornerRadius="20" Margin="-4" BorderThickness="2" BorderBrush="Transparent" IsHitTestVisible="False" />
            </Panel>
          </c:AspectPanel>
          <TextBlock Name="PART_Name" Text="{TemplateBinding Title}" FontSize="13" LineHeight="18" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
          <TextBlock Name="PART_Meta" Text="{TemplateBinding Meta}" FontSize="12" LineHeight="16" Foreground="{DynamicResource ink-faint}" Margin="0,-4,0,0"
                     IsVisible="{Binding $parent[c:GsGameTile].Meta, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:art /template/ Panel#PART_TitleCover">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^.compact /template/ TextBlock#PART_Name">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="LineHeight" Value="16" />
    </Style>
    <Style Selector="^:pointerover /template/ Border#PART_Hover">
      <Setter Property="BorderBrush" Value="{DynamicResource bg-400}" />
    </Style>
  </ControlTheme>

  <!-- Rows packed tight (the game list) draw the focus ring just inside themselves (A11Y-02) -->
  <FocusAdornerTemplate x:Key="InsetFocus">
    <Border BorderBrush="{DynamicResource primary}" BorderThickness="2" CornerRadius="10" />
  </FocusAdornerTemplate>

  <!-- GameList row: the small cover, the name, the status under it when it needs you or runs; dimmed when not installed -->
  <ControlTheme x:Key="{x:Type c:GsGameRow}" TargetType="c:GsGameRow">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ink}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{StaticResource InsetFocus}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource radius-md}" Padding="{TemplateBinding Padding}">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <Border Name="PART_Cover" Width="20" Height="30" CornerRadius="{DynamicResource radius-sm}" ClipToBounds="True" Background="{DynamicResource bg-300}"
                    VerticalAlignment="Center">
              <Panel>
                <TextBlock Text="{TemplateBinding Initial}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ink-muted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <c:GsCoverImage Source="{TemplateBinding Art}" />
              </Panel>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Name="PART_Name" Text="{TemplateBinding Title}" LineHeight="18" TextTrimming="CharacterEllipsis" />
              <c:GsStatusBadge Status="{TemplateBinding Status}" Label="{TemplateBinding StatusLabel}" Plain="True" FontSize="11"
                               IsVisible="{TemplateBinding ShowsStatus}" />
            </StackPanel>
            <!-- Saves fine (KAN-48): the same check as the covers', small at the row's end -->
            <c:GsIcon Grid.Column="2" Name="PART_Mark" Icon="check" Size="14" StrokeWidth="2.5" Foreground="{DynamicResource ok}" VerticalAlignment="Center"
                      Margin="0,0,2,0" IsVisible="{TemplateBinding ShowsMark}" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource bg-300}" />
    </Style>
    <Style Selector="^:current">
      <Setter Property="Background" Value="{DynamicResource secondary-soft}" />
    </Style>
    <Style Selector="^:away /template/ TextBlock#PART_Name">
      <Setter Property="Foreground" Value="{DynamicResource ink-faint}" />
    </Style>
    <Style Selector="^:away /template/ Border#PART_Cover">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
  </ControlTheme>

  <!-- GameList group heading: overline and a mono count, with a chevron; a click opens or closes the group -->
  <ControlTheme x:Key="{x:Type c:GsListHeading}" TargetType="c:GsListHeading">
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ink-faint}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{StaticResource InsetFocus}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource radius-sm}" Padding="{TemplateBinding Padding}">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <c:GsIcon Name="PART_Chevron" Icon="chevronDown" Size="14" StrokeWidth="2" VerticalAlignment="Center" />
            <TextBlock Text="{TemplateBinding Label, Converter={x:Static c:UpperConverter.Instance}}" FontSize="11" LineHeight="14" FontWeight="SemiBold"
                       LetterSpacing="1.32" VerticalAlignment="Center" />
            <TextBlock Text="{TemplateBinding Count}" FontFamily="{DynamicResource font-mono}" FontSize="11" LineHeight="14" FontWeight="Medium" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource ink}" />
    </Style>
    <Style Selector="^:closed /template/ c|GsIcon#PART_Chevron">
      <Setter Property="Icon" Value="chevronRight" />
    </Style>
  </ControlTheme>

  <!-- Chip: on cover art, the same in every theme and surface -->
  <ControlTheme x:Key="{x:Type c:GsChip}" TargetType="c:GsChip">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Foreground" Value="{DynamicResource on-art}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{DynamicResource glass}" BorderBrush="{DynamicResource glass-edge}" BorderThickness="1" BackgroundSizing="OuterBorderEdge"
                CornerRadius="13" Height="26" Padding="10,0">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <c:GsIcon Icon="{TemplateBinding Icon}" Size="14" VerticalAlignment="Center"
                      IsVisible="{Binding $parent[c:GsChip].Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Text="{TemplateBinding Text}" FontSize="12" LineHeight="16" FontWeight="Medium" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- HeroBanner: text sits on the art, so it uses on-art over the art-scrim fade in every theme -->
  <ControlTheme x:Key="{x:Type c:GsHeroBanner}" TargetType="c:GsHeroBanner">
    <!-- Its ring sits just outside the art, which Avalonia 12's clip to bounds would hide -->
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="MinHeight" Value="280" />
    <Setter Property="Foreground" Value="{DynamicResource on-art}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
        <!-- KAN-50: the game is running: a glow in the play colour behind the art (its light painted in code), easing in
             and out (KAN-72) -->
        <Border Name="PART_Glow" CornerRadius="16" Opacity="0" IsHitTestVisible="False" />
        <Border CornerRadius="16" ClipToBounds="True" Background="{DynamicResource glass}">
          <Panel>
            <c:GsCoverImage Source="{TemplateBinding Art}" />
            <!-- KAN-72: the picture before, fading away over the new one when the game changes -->
            <c:GsCoverImage Name="PART_ArtBefore" Opacity="0" IsHitTestVisible="False" />
            <Grid RowDefinitions="35*,30*,35*" IsHitTestVisible="False">
              <Border Grid.Row="0">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="#73050608" Offset="0" />
                    <GradientStop Color="#00050608" Offset="1" />
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <Border Grid.Row="1" Grid.RowSpan="2">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0%,100%" EndPoint="0%,0%">
                    <GradientStop Color="#B8050608" Offset="0" />
                    <GradientStop Color="#00050608" Offset="1" />
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
            </Grid>
            <DockPanel Margin="20">
              <!-- Where it's installed: a store's mark (or a folder) with its words under the pointer, then the eyebrow (KAN-55) -->
              <DockPanel DockPanel.Dock="Top">
                <Border DockPanel.Dock="Left" Background="Transparent" Margin="0,0,8,0" VerticalAlignment="Center"
                        IsVisible="{Binding $parent[c:GsHeroBanner].EyebrowIcon, Converter={x:Static ObjectConverters.IsNotNull}}"
                        ToolTip.Tip="{TemplateBinding EyebrowTip}" AutomationProperties.Name="{TemplateBinding EyebrowTip}">
                  <c:GsIcon Icon="{TemplateBinding EyebrowIcon}" Size="20" />
                </Border>
                <TextBlock Text="{TemplateBinding Eyebrow}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </DockPanel>
              <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Bottom">
                <StackPanel Spacing="8" MaxWidth="560" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                  <c:GsChip Icon="clock" Text="{TemplateBinding Chip}">
                    <c:GsChip.IsVisible>
                      <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="$parent[c:GsHeroBanner].Chip" Converter="{x:Static ObjectConverters.IsNotNull}" />
                        <Binding Path="$parent[c:GsHeroBanner].HasRoom" />
                      </MultiBinding>
                    </c:GsChip.IsVisible>
                  </c:GsChip>
                  <Image Name="PART_Logo" Source="{TemplateBinding Logo}" MaxWidth="380" MaxHeight="112" Stretch="Uniform" HorizontalAlignment="Left" IsVisible="False" />
                  <TextBlock Name="PART_Title" Classes="hero-title" Text="{TemplateBinding Title}" TextWrapping="Wrap" />
                  <c:GsStatusBadge Classes="art" Status="{TemplateBinding Status}" Label="{TemplateBinding StatusLabel}" IsVisible="{TemplateBinding ShowsStatus}" />
                  <TextBlock Text="{TemplateBinding Blurb}" FontSize="13" LineHeight="19" Opacity="0.88" TextWrapping="Wrap">
                    <TextBlock.IsVisible>
                      <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="$parent[c:GsHeroBanner].Blurb" Converter="{x:Static ObjectConverters.IsNotNull}" />
                        <Binding Path="$parent[c:GsHeroBanner].HasRoom" />
                      </MultiBinding>
                    </TextBlock.IsVisible>
                  </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom" Margin="20,0,0,0">
                  <!-- A game's page brings its own glass buttons (the favourite star and More) -->
                  <ContentPresenter Content="{TemplateBinding Actions}" VerticalAlignment="Center"
                                    IsVisible="{Binding $parent[c:GsHeroBanner].Actions, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  <c:GsIconButton Classes="glass" Icon="saves" Label="Manage saves" Command="{TemplateBinding SavesCommand}"
                                  IsVisible="{Binding $parent[c:GsHeroBanner].Actions, Converter={x:Static ObjectConverters.IsNull}}" />
                  <c:GsIconButton Classes="glass" Icon="settings" Label="Properties" Command="{TemplateBinding SettingsCommand}"
                                  IsVisible="{Binding $parent[c:GsHeroBanner].Actions, Converter={x:Static ObjectConverters.IsNull}}" />
                  <c:GsButton Classes="primary" Icon="{TemplateBinding PlayIcon}" Content="{TemplateBinding PlayLabel}" Command="{TemplateBinding PlayCommand}"
                              IsVisible="{TemplateBinding ShowsPlay}" />
                </StackPanel>
              </Grid>
            </DockPanel>
          </Panel>
        </Border>
        <Border CornerRadius="17" Margin="-1" BorderBrush="{DynamicResource edge-art}" BorderThickness="1" IsHitTestVisible="False" />
        <Border Name="PART_PlayRing" CornerRadius="19" Margin="-3" BorderBrush="{DynamicResource play}" BorderThickness="2" Opacity="0" IsHitTestVisible="False" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:playing /template/ Border#PART_Glow">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="^:playing /template/ Border#PART_PlayRing">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="^:logo /template/ Image#PART_Logo">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:logo /template/ TextBlock#PART_Title">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </ControlTheme>
  <!-- PlayBar: a card under a game's hero; Play, the facts in a row that wraps, the game's buttons -->
  <ControlTheme x:Key="{x:Type c:GsPlayBar}" TargetType="c:GsPlayBar">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{DynamicResource bg-200}" BorderBrush="{DynamicResource edge-card}" BorderThickness="1" BackgroundSizing="OuterBorderEdge"
                BoxShadow="{DynamicResource lift-card}" CornerRadius="{DynamicResource radius-lg}" Padding="20,16">
          <DockPanel>
            <ContentPresenter DockPanel.Dock="Left" Content="{TemplateBinding Primary}" VerticalAlignment="Center" Margin="0,0,24,0"
                              IsVisible="{Binding $parent[c:GsPlayBar].Primary, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <ContentPresenter DockPanel.Dock="Right" Content="{TemplateBinding Actions}" VerticalAlignment="Center" Margin="24,0,0,0" />
            <ItemsControl ItemsSource="{TemplateBinding Stats}" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel ItemSpacing="24" LineSpacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="c:PlayStat">
                  <StackPanel Spacing="2" AutomationProperties.Name="{Binding}">
                    <TextBlock Classes="overline faint" Text="{Binding Label, Converter={x:Static c:UpperConverter.Instance}}" />
                    <TextBlock Text="{Binding Value}" FontSize="14" LineHeight="20" FontWeight="Medium" IsVisible="{Binding IsText}" />
                    <c:GsStatusBadge Plain="True" Status="{Binding Status}" Label="{Binding Value}" FontSize="14" IsVisible="{Binding IsStatus}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DockPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- Facts: an overline label beside each value, the labels in one column -->
  <ControlTheme x:Key="{x:Type c:GsFacts}" TargetType="c:GsFacts">
    <Setter Property="Grid.IsSharedSizeScope" Value="True" />
    <Setter Property="Template">
      <ControlTemplate>
        <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
      </ControlTemplate>
    </Setter>
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Spacing="8" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="ItemTemplate">
      <DataTemplate x:DataType="c:Fact">
        <Grid ColumnSpacing="16" AutomationProperties.Name="{Binding}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="FactLabel" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Classes="overline faint" Text="{Binding Label, Converter={x:Static c:UpperConverter.Instance}}" LineHeight="20" VerticalAlignment="Top" />
          <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13" LineHeight="20" TextWrapping="Wrap" IsVisible="{Binding IsPlain}" />
          <TextBlock Grid.Column="1" Classes="mono-fact" Text="{Binding Value}" LineHeight="20" TextTrimming="LeadingCharacterEllipsis"
                     ToolTip.Tip="{Binding Value}" IsVisible="{Binding IsMono}" />
          <ItemsControl Grid.Column="1" ItemsSource="{Binding Tags}" IsVisible="{Binding HasTags}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel ItemSpacing="6" LineSpacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="sys:String">
                <c:GsTag Text="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </DataTemplate>
    </Setter>
  </ControlTheme>

  <!-- ActivityGrid: the legend, a cell a day, and the weekday names -->
  <ControlTheme x:Key="{x:Type c:GsActivity}" TargetType="c:GsActivity">
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="16" TextElement.Foreground="{DynamicResource ink-muted}" TextElement.FontSize="12">
            <StackPanel Orientation="Horizontal" Spacing="6"><c:GsLevelDot Level="0" VerticalAlignment="Center" /><TextBlock Text="0h" /></StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6"><c:GsLevelDot Level="1" VerticalAlignment="Center" /><TextBlock Text="&lt; 2h" /></StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6"><c:GsLevelDot Level="2" VerticalAlignment="Center" /><TextBlock Text="2–4h" /></StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6"><c:GsLevelDot Level="3" VerticalAlignment="Center" /><TextBlock Text="&gt; 4h" /></StackPanel>
          </StackPanel>
          <c:GsActivityGrid Days="{TemplateBinding Days}" StartWeekday="{TemplateBinding StartWeekday}" Tips="{TemplateBinding Tips}"
                            DayCommand="{TemplateBinding DayCommand}" />
          <UniformGrid Columns="7" TextElement.Foreground="{DynamicResource ink-faint}" TextElement.FontSize="11">
            <TextBlock Text="Mon" HorizontalAlignment="Center" />
            <TextBlock Text="Tue" HorizontalAlignment="Center" />
            <TextBlock Text="Wed" HorizontalAlignment="Center" />
            <TextBlock Text="Thu" HorizontalAlignment="Center" />
            <TextBlock Text="Fri" HorizontalAlignment="Center" />
            <TextBlock Text="Sat" HorizontalAlignment="Center" />
            <TextBlock Text="Sun" HorizontalAlignment="Center" />
          </UniformGrid>
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
