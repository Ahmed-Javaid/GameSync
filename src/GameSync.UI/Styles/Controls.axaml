<!-- The design system's components as control themes (design/system/components/bundle.css is the spec). -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:GameSync.UI.Controls">

  <!-- Focus: a 2px primary ring offset by 2px, shown for keyboard focus (A11Y-02). An adorner is clipped to its control's
       bounds unless told not to, which cut the ring away outside it and left only its corners on a pill or a circle. -->
  <FocusAdornerTemplate x:Key="PillFocus">
    <Border AdornerLayer.IsClipEnabled="False" BorderBrush="{DynamicResource primary}" BorderThickness="2" CornerRadius="999" Margin="-4" />
  </FocusAdornerTemplate>
  <FocusAdornerTemplate x:Key="RoundedFocus">
    <Border AdornerLayer.IsClipEnabled="False" BorderBrush="{DynamicResource primary}" BorderThickness="2" CornerRadius="12" Margin="-4" />
  </FocusAdornerTemplate>
  <FocusAdornerTemplate x:Key="SmallFocus">
    <Border AdornerLayer.IsClipEnabled="False" BorderBrush="{DynamicResource primary}" BorderThickness="2" CornerRadius="8" Margin="-4" />
  </FocusAdornerTemplate>

  <!-- Button -->
  <ControlTheme x:Key="{x:Type c:GsButton}" TargetType="c:GsButton">
    <Setter Property="Height" Value="{DynamicResource control-height}" />
    <Setter Property="Padding" Value="20,0" />
    <!-- A pill is half its height round: with the background under the border, a larger radius draws an ellipse. -->
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Background" Value="{DynamicResource bg-300}" />
    <Setter Property="BorderBrush" Value="{DynamicResource edge-control}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource ink}" />
    <Setter Property="FontSize" Value="{DynamicResource fs-14}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FocusAdorner" Value="{StaticResource PillFocus}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                BackgroundSizing="OuterBorderEdge" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
          <!-- KAN-80: busy, the spinner takes the icon's place and the busy words the content's, with dots counting up -->
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
            <c:GsIcon Icon="{TemplateBinding Icon}" Size="{TemplateBinding IconSize}" VerticalAlignment="Center" IsVisible="{TemplateBinding ShowsIcon}" />
            <c:GsSpinner Size="{TemplateBinding IconSize}" VerticalAlignment="Center" IsVisible="{TemplateBinding ShowsBusy}" />
            <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" IsVisible="{Binding !ShowsBusy, RelativeSource={RelativeSource TemplatedParent}}" />
            <c:GsBusyText Words="{TemplateBinding BusyWords}" VerticalAlignment="Center" IsVisible="{TemplateBinding ShowsBusy}" />
            <c:GsIcon Icon="{TemplateBinding IconAfter}" Size="16" VerticalAlignment="Center" IsVisible="{TemplateBinding ShowsIconAfter}" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource bg-400}" />
    </Style>
    <Style Selector="^.primary">
      <Setter Property="Background" Value="{DynamicResource primary}" />
      <Setter Property="Foreground" Value="{DynamicResource on-primary}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="^.primary:pointerover">
      <Setter Property="Background" Value="{DynamicResource primary-strong}" />
    </Style>
    <Style Selector="^.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource ink-muted}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="12,0" />
    </Style>
    <Style Selector="^.ghost:pointerover">
      <Setter Property="Background" Value="{DynamicResource bg-300}" />
      <Setter Property="Foreground" Value="{DynamicResource ink}" />
    </Style>
    <Style Selector="^.danger">
      <Setter Property="Background" Value="{DynamicResource danger-soft}" />
      <Setter Property="Foreground" Value="{DynamicResource danger}" />
    </Style>
    <Style Selector="^.sm">
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="FontSize" Value="{DynamicResource fs-13}" />
      <Setter Property="IconSize" Value="16" />
    </Style>
    <Style Selector="^.ghost.sm">
      <Setter Property="Padding" Value="12,0" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <!-- KAN-80: a busy button isn't disabled: it keeps its colour, whatever its command says meanwhile -->
    <Style Selector="^:busy">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Cursor" Value="AppStarting" />
    </Style>
  </ControlTheme>

  <!-- IconButton -->
  <ControlTheme x:Key="{x:Type c:GsIconButton}" TargetType="c:GsIconButton">
    <Setter Property="Width" Value="{DynamicResource control-height}" />
    <Setter Property="Height" Value="{DynamicResource control-height}" />
    <Setter Property="Background" Value="{DynamicResource bg-300}" />
    <Setter Property="BorderBrush" Value="{DynamicResource edge-control}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource ink}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FocusAdorner" Value="{StaticResource PillFocus}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                BackgroundSizing="OuterBorderEdge" CornerRadius="999">
          <c:GsIcon Icon="{TemplateBinding Icon}" Size="{TemplateBinding IconSize}" Filled="{TemplateBinding IsOn}" IsSpinning="{TemplateBinding IsBusy}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource bg-400}" />
    </Style>
    <!-- A toggle that's on (the favourite star): its icon fills in secondary, or in on-art on the art -->
    <Style Selector="^:on">
      <Setter Property="Foreground" Value="{DynamicResource secondary}" />
    </Style>
    <Style Selector="^.glass:on">
      <Setter Property="Foreground" Value="{DynamicResource on-art}" />
    </Style>
    <Style Selector="^.sm">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="IconSize" Value="16" />
    </Style>
    <Style Selector="^.glass">
      <Setter Property="Background" Value="{DynamicResource glass}" />
      <Setter Property="BorderBrush" Value="{DynamicResource glass-edge}" />
      <Setter Property="Foreground" Value="{DynamicResource on-art}" />
    </Style>
    <Style Selector="^.glass:pointerover">
      <Setter Property="Background" Value="{DynamicResource art-scrim}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
  </ControlTheme>

  <!-- A breadcrumb's link back (My games › the game): ink-muted text, ink under the pointer -->
  <ControlTheme x:Key="CrumbButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ink-muted}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="{DynamicResource fs-13}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FocusAdorner" Value="{StaticResource SmallFocus}" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Background="{TemplateBinding Background}" Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource ink}" />
    </Style>
  </ControlTheme>

  <!-- Card: in Glossy, a hairline edge and a lit top edge (lift) over the backdrop; both are clear in Solid -->
  <ControlTheme x:Key="{x:Type c:GsCard}" TargetType="c:GsCard">
    <Setter Property="Background" Value="{DynamicResource bg-200}" />
    <Setter Property="BorderBrush" Value="{DynamicResource edge-card}" />
    <Setter Property="BorderThickness" Value="1" />
    <!-- Light mode's lift (design system version 35) is a shadow under the card, outside its box: unclipped -->
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="CornerRadius" Value="{DynamicResource radius-lg}" />
    <Setter Property="Padding" Value="20" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                BackgroundSizing="OuterBorderEdge" BoxShadow="{DynamicResource lift-card}" CornerRadius="{TemplateBinding CornerRadius}">
          <Panel>
          <!-- Art behind the title and content (Backdrop): the whole card, clipped to its corners -->
          <Border Name="PART_Backdrop" CornerRadius="{TemplateBinding CornerRadius}" ClipToBounds="True" IsHitTestVisible="False" IsVisible="False">
            <ContentPresenter Content="{TemplateBinding Backdrop}" />
          </Border>
          <DockPanel Margin="{TemplateBinding Padding}">
            <Grid Name="PART_Header" DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,16" IsVisible="False">
              <ContentPresenter Name="PART_Lead" Content="{TemplateBinding Lead}" VerticalAlignment="Center" Margin="0,0,12,0" IsVisible="False" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Classes="card-title" Text="{TemplateBinding Title}" TextWrapping="Wrap" />
                <TextBlock Name="PART_Subtitle" Classes="caption muted" Text="{TemplateBinding Subtitle}" Margin="0,2,0,0" TextWrapping="Wrap" IsVisible="False" />
              </StackPanel>
              <ContentPresenter Grid.Column="2" Content="{TemplateBinding Action}" VerticalAlignment="Center" Margin="12,0,0,0" />
            </Grid>
            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
          </DockPanel>
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:backdrop /template/ Border#PART_Backdrop">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:header /template/ Grid#PART_Header">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:lead /template/ ContentPresenter#PART_Lead">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:subtitle /template/ TextBlock#PART_Subtitle">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </ControlTheme>

  <!-- StatusBadge: status colours never follow the theme -->
  <ControlTheme x:Key="{x:Type c:GsStatusBadge}" TargetType="c:GsStatusBadge">
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="8,0,10,0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontSize" Value="{DynamicResource fs-12}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="999" Padding="{TemplateBinding Padding}">
          <!-- A grid, not a row, so a long label ("Synced by its store") ends in an ellipsis instead of running past its box (KAN-45) -->
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalAlignment="Center">
            <c:GsIcon Icon="{TemplateBinding IconName}" Size="14" StrokeWidth="2" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{TemplateBinding Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:ok">
      <Setter Property="Background" Value="{DynamicResource ok-soft}" />
      <Setter Property="Foreground" Value="{DynamicResource ok}" />
    </Style>
    <Style Selector="^:warn">
      <Setter Property="Background" Value="{DynamicResource warn-soft}" />
      <Setter Property="Foreground" Value="{DynamicResource warn}" />
    </Style>
    <Style Selector="^:play">
      <Setter Property="Background" Value="{DynamicResource play-soft}" />
      <Setter Property="Foreground" Value="{DynamicResource play}" />
    </Style>
    <Style Selector="^:danger">
      <Setter Property="Background" Value="{DynamicResource danger-soft}" />
      <Setter Property="Foreground" Value="{DynamicResource danger}" />
    </Style>
    <Style Selector="^:neutral">
      <Setter Property="Background" Value="{DynamicResource bg-300}" />
      <Setter Property="Foreground" Value="{DynamicResource neutral}" />
    </Style>
    <Style Selector="^:plain">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Height" Value="NaN" />
    </Style>
    <!-- On cover art: a deep tint that keeps 4.5:1 over any art, in both surfaces -->
    <Style Selector="^.art:ok">
      <Setter Property="Background" Value="{DynamicResource ok-art}" />
    </Style>
    <Style Selector="^.art:warn">
      <Setter Property="Background" Value="{DynamicResource warn-art}" />
    </Style>
    <Style Selector="^.art:play">
      <Setter Property="Background" Value="{DynamicResource play-art}" />
    </Style>
    <Style Selector="^.art:danger">
      <Setter Property="Background" Value="{DynamicResource danger-art}" />
    </Style>
    <Style Selector="^.art:neutral">
      <Setter Property="Background" Value="{DynamicResource neutral-art}" />
    </Style>
  </ControlTheme>

  <!-- Tag -->
  <ControlTheme x:Key="{x:Type c:GsTag}" TargetType="c:GsTag">
    <Setter Property="Background" Value="{DynamicResource bg-300}" />
    <Setter Property="Foreground" Value="{DynamicResource ink-muted}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="999" Height="18" Padding="7,0">
          <TextBlock Text="{TemplateBinding Text, Converter={x:Static c:UpperConverter.Instance}}" FontSize="{DynamicResource fs-10}" LineHeight="{DynamicResource lh-14}"
                     FontWeight="SemiBold" LetterSpacing="0.8" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- Note; busy, a BusyLine (KAN-80) -->
  <ControlTheme x:Key="{x:Type c:GsNote}" TargetType="c:GsNote">
    <Setter Property="Foreground" Value="{DynamicResource ink-muted}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="Auto,*">
          <Panel VerticalAlignment="Top">
            <c:GsIcon Icon="{TemplateBinding Icon}" Size="16" IsVisible="{Binding !IsBusy, RelativeSource={RelativeSource TemplatedParent}}" />
            <c:GsSpinner Size="16" IsVisible="{TemplateBinding IsBusy}" />
          </Panel>
          <c:GsBusyText Grid.Column="1" Words="{TemplateBinding Text}" IsBusy="{TemplateBinding IsBusy}" Margin="8,0,0,0" FontSize="{DynamicResource fs-12}" LineHeight="{DynamicResource lh-16}" TextWrapping="Wrap" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- Switch -->
  <ControlTheme x:Key="{x:Type c:GsSwitch}" TargetType="c:GsSwitch">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource bg-300}" />
    <Setter Property="BorderBrush" Value="{DynamicResource line-200}" />
    <Setter Property="FocusAdorner" Value="{StaticResource PillFocus}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="999">
          <Ellipse Name="PART_Knob" Width="15" Height="15" Margin="2,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{DynamicResource ink-muted}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:checked">
      <Setter Property="Background" Value="{DynamicResource primary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource primary}" />
    </Style>
    <Style Selector="^:checked /template/ Ellipse#PART_Knob">
      <Setter Property="Margin" Value="20,0,0,0" />
      <Setter Property="Fill" Value="{DynamicResource on-primary}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
  </ControlTheme>

  <!-- CheckBox: a primary fill when ticked; the border meets 3:1 in every theme -->
  <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FocusAdorner" Value="{StaticResource SmallFocus}" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Orientation="Horizontal" Spacing="8" Background="{TemplateBinding Background}">
          <Border Name="PART_Box" Width="18" Height="18" CornerRadius="{DynamicResource radius-sm}" BorderThickness="1.5"
                  BorderBrush="{DynamicResource line-200}" Background="Transparent" VerticalAlignment="Center">
            <Panel>
              <Path Name="PART_Check" Data="M3.5 9 L7 12.5 L14 5.5" Stroke="{DynamicResource on-primary}" StrokeThickness="2"
                    StrokeLineCap="Round" StrokeJoin="Round" IsVisible="False" Margin="-1.5" />
              <Rectangle Name="PART_Dash" Width="9" Height="2" Fill="{DynamicResource on-primary}" IsVisible="False" />
            </Panel>
          </Border>
          <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center"
                            IsVisible="{Binding $parent[CheckBox].Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:checked /template/ Border#PART_Box">
      <Setter Property="Background" Value="{DynamicResource primary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource primary}" />
    </Style>
    <Style Selector="^:checked /template/ Path#PART_Check">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:indeterminate /template/ Border#PART_Box">
      <Setter Property="Background" Value="{DynamicResource primary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource primary}" />
    </Style>
    <Style Selector="^:indeterminate /template/ Rectangle#PART_Dash">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
  </ControlTheme>

  <!-- ProgressBar and GsProgress -->
  <ControlTheme x:Key="{x:Type ProgressBar}" TargetType="ProgressBar">
    <Setter Property="Height" Value="6" />
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="Background" Value="{DynamicResource bg-400}" />
    <Setter Property="Foreground" Value="{DynamicResource primary}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="999" ClipToBounds="True">
          <Border Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="999" HorizontalAlignment="Left" />
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
  <!-- JobProgress (KAN-80): a job under way where its result will show; boxed, on a card of its own -->
  <ControlTheme x:Key="{x:Type c:GsJobProgress}" TargetType="c:GsJobProgress">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                BackgroundSizing="OuterBorderEdge" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
              <Panel VerticalAlignment="Center">
                <c:GsSpinner Name="PART_Spinner" Size="16" Foreground="{DynamicResource primary}" IsVisible="{TemplateBinding IsRunning}" />
                <c:GsIcon Name="PART_Icon" Icon="{TemplateBinding IconName}" Size="16" StrokeWidth="2" Foreground="{DynamicResource primary}"
                          IsVisible="{Binding !IsRunning, RelativeSource={RelativeSource TemplatedParent}}" />
              </Panel>
              <c:GsBusyText Grid.Column="1" Words="{TemplateBinding Title}" FontSize="{DynamicResource fs-13}" LineHeight="{DynamicResource lh-18}" FontWeight="SemiBold" Foreground="{DynamicResource ink}"
                            TextTrimming="CharacterEllipsis" VerticalAlignment="Center" IsBusy="False" />
              <TextBlock Grid.Column="2" Classes="mono-small" Text="{TemplateBinding RightText}" FontWeight="Medium" Foreground="{DynamicResource ink}" VerticalAlignment="Center" />
            </Grid>
            <c:GsJobBar Name="PART_Bar" Value="{TemplateBinding BarValue}" IsRunning="{TemplateBinding IsRunning}" Fill="{DynamicResource primary}" Track="{DynamicResource bg-400}" />
            <!-- How far, in mono; or once it's stopped, why or how it ended, in prose -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding FootText, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock Classes="mono-small muted" Text="{TemplateBinding FootText}" TextTrimming="CharacterEllipsis" IsVisible="{Binding !ShowsNote, RelativeSource={RelativeSource TemplatedParent}}" />
              <TextBlock Classes="caption muted" Text="{TemplateBinding FootText}" TextWrapping="Wrap" IsVisible="{TemplateBinding ShowsNote}" />
              <TextBlock Grid.Column="1" Classes="mono-small muted" Text="{TemplateBinding Left}" IsVisible="{TemplateBinding ShowsLeft}" />
            </Grid>
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^.boxed">
      <Setter Property="Background" Value="{DynamicResource bg-200}" />
      <Setter Property="BorderBrush" Value="{DynamicResource edge-card}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource radius-lg}" />
      <Setter Property="Padding" Value="20,14" />
    </Style>
    <Style Selector="^.boxed /template/ Border#PART_Box">
      <Setter Property="BoxShadow" Value="{DynamicResource lift-card}" />
    </Style>
    <!-- How it ended, or why it waits: the status colours, which never follow the theme -->
    <Style Selector="^:done /template/ c|GsIcon#PART_Icon">
      <Setter Property="Foreground" Value="{DynamicResource ok}" />
    </Style>
    <Style Selector="^:done /template/ c|GsJobBar#PART_Bar">
      <Setter Property="Fill" Value="{DynamicResource ok}" />
    </Style>
    <Style Selector="^:failed /template/ c|GsIcon#PART_Icon">
      <Setter Property="Foreground" Value="{DynamicResource warn}" />
    </Style>
    <Style Selector="^:failed /template/ c|GsJobBar#PART_Bar">
      <Setter Property="Fill" Value="{DynamicResource warn}" />
    </Style>
    <Style Selector="^:paused /template/ c|GsIcon#PART_Icon">
      <Setter Property="Foreground" Value="{DynamicResource neutral}" />
    </Style>
    <Style Selector="^:paused /template/ c|GsJobBar#PART_Bar">
      <Setter Property="Fill" Value="{DynamicResource neutral}" />
    </Style>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type c:GsProgress}" TargetType="c:GsProgress">
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="mono-small muted" Text="{TemplateBinding Label}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1" Classes="mono-small muted" Text="{TemplateBinding Right}" Margin="12,0,0,0" />
          </Grid>
          <ProgressBar Minimum="0" Maximum="100" Value="{TemplateBinding Value}" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- SettingsRow -->
  <ControlTheme x:Key="{x:Type c:GsSettingsRow}" TargetType="c:GsSettingsRow">
    <Setter Property="MinHeight" Value="56" />
    <Setter Property="Padding" Value="0,12" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
        <Grid Name="PART_Grid" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="{TemplateBinding Padding}">
          <StackPanel Name="PART_Text" Spacing="2" VerticalAlignment="Center" Margin="0,0,20,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Width="20" Height="30" CornerRadius="4" ClipToBounds="True" Margin="0,0,2,0" VerticalAlignment="Center"
                      IsVisible="{Binding $parent[c:GsSettingsRow].Thumb, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Image Source="{TemplateBinding Thumb}" Stretch="UniformToFill" />
              </Border>
              <TextBlock Name="PART_Title" Text="{TemplateBinding Title}" FontWeight="Medium" TextWrapping="Wrap" VerticalAlignment="Center" />
              <c:GsTag Text="{TemplateBinding TagText}" IsVisible="{Binding $parent[c:GsSettingsRow].TagText, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
            <TextBlock Classes="caption muted" Text="{TemplateBinding Description}" TextWrapping="Wrap" MaxWidth="460" HorizontalAlignment="Left"
                       IsVisible="{Binding $parent[c:GsSettingsRow].Description, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
          <ContentPresenter Name="PART_Control" Grid.Column="1" Content="{TemplateBinding Content}" VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:stack /template/ ContentPresenter#PART_Control">
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Grid.Row" Value="1" />
      <Setter Property="Grid.ColumnSpan" Value="2" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="0,12,0,0" />
    </Style>
    <Style Selector="^:disabled /template/ TextBlock#PART_Title">
      <Setter Property="Foreground" Value="{DynamicResource ink-muted}" />
    </Style>
  </ControlTheme>

  <!-- PillTabs -->
  <ControlTheme x:Key="PillTabItem" TargetType="ListBoxItem">
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource bg-400}" />
    <Setter Property="Foreground" Value="{DynamicResource ink-muted}" />
    <Setter Property="FontSize" Value="{DynamicResource fs-13}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FocusAdorner" Value="{StaticResource PillFocus}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="999" Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource ink}" />
    </Style>
    <Style Selector="^:selected">
      <Setter Property="Background" Value="{DynamicResource secondary-soft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource secondary-soft}" />
      <Setter Property="Foreground" Value="{DynamicResource ink}" />
    </Style>
    <!-- Needs you while something does (design system version 32): the warn colours, selected or not -->
    <Style Selector="^.warn, ^.warn:pointerover, ^.warn:selected">
      <Setter Property="Background" Value="{DynamicResource warn-soft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource warn-soft}" />
      <Setter Property="Foreground" Value="{DynamicResource warn}" />
    </Style>
    <Style Selector="^.warn:selected">
      <Setter Property="BorderBrush" Value="{DynamicResource warn}" />
    </Style>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type c:GsPillTabs}" TargetType="c:GsPillTabs">
    <Setter Property="ItemContainerTheme" Value="{StaticResource PillTabItem}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" Spacing="8" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="ItemTemplate">
      <DataTemplate x:DataType="c:NavItem">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <c:GsIcon Classes="selectable" Icon="{Binding PlainIcon}" Size="16" VerticalAlignment="Center" IsVisible="{Binding PlainIcon, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <c:GsIcon Icon="alert" Size="16" Foreground="{DynamicResource warn}" VerticalAlignment="Center" IsVisible="{Binding IsWarn}" />
          <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
          <Panel VerticalAlignment="Center" IsVisible="{Binding Count, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Border Background="{DynamicResource secondary}" CornerRadius="999" Padding="6,0" IsVisible="{Binding !IsWarn}">
              <TextBlock Text="{Binding Count}" Foreground="{DynamicResource on-secondary}" FontFamily="{DynamicResource font-mono}" FontSize="{DynamicResource fs-11}" LineHeight="{DynamicResource lh-16}" FontWeight="Medium" />
            </Border>
            <Border Background="{DynamicResource bg-100}" CornerRadius="999" Padding="6,0" IsVisible="{Binding IsWarn}">
              <TextBlock Text="{Binding Count}" Foreground="{DynamicResource warn}" FontFamily="{DynamicResource font-mono}" FontSize="{DynamicResource fs-11}" LineHeight="{DynamicResource lh-16}" FontWeight="Medium" />
            </Border>
          </Panel>
        </StackPanel>
      </DataTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- SettingsNav -->
  <ControlTheme x:Key="SettingsNavItem" TargetType="ListBoxItem">
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ink-muted}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FocusAdorner" Value="{StaticResource RoundedFocus}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource radius-md}" Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" VerticalAlignment="Center"
                            HorizontalContentAlignment="Stretch" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource bg-300}" />
      <Setter Property="Foreground" Value="{DynamicResource ink}" />
    </Style>
    <Style Selector="^:selected">
      <Setter Property="Background" Value="{DynamicResource secondary-soft}" />
      <Setter Property="Foreground" Value="{DynamicResource ink}" />
    </Style>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type c:GsSettingsNav}" TargetType="c:GsSettingsNav">
    <Setter Property="ItemContainerTheme" Value="{StaticResource SettingsNavItem}" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Spacing="2" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="ItemTemplate">
      <DataTemplate x:DataType="c:NavItem">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <c:GsIcon Classes="selectable" Icon="{Binding Icon}" Size="18" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="12,0,0,0" VerticalAlignment="Center" />
          <Border Grid.Column="2" Background="{DynamicResource warn-soft}" CornerRadius="999" Padding="6,0" VerticalAlignment="Center"
                  IsVisible="{Binding Count, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding Count}" Foreground="{DynamicResource warn}" FontFamily="{DynamicResource font-mono}" FontSize="{DynamicResource fs-11}" LineHeight="{DynamicResource lh-16}" FontWeight="Medium" />
          </Border>
        </Grid>
      </DataTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- SideRail -->
  <ControlTheme x:Key="{x:Type c:GsRailButton}" TargetType="c:GsRailButton">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ink-faint}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{StaticResource RoundedFocus}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource radius-md}">
          <Panel>
            <c:GsIcon Icon="{TemplateBinding Icon}" Size="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Ellipse Width="12" Height="12" Fill="{DynamicResource dot-ring}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0"
                     IsVisible="{Binding $parent[c:GsRailButton].DotBrush, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <Ellipse Width="8" Height="8" Fill="{TemplateBinding DotBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,7,0"
                     IsVisible="{Binding $parent[c:GsRailButton].DotBrush, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <!-- Something needs the person: a caution mark on the rail's own ring (design system version 32) -->
            <Panel Width="17" Height="17" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,1,0" IsVisible="{TemplateBinding IsCaution}">
              <Ellipse Fill="{DynamicResource dot-ring}" />
              <c:GsIcon Icon="alert" Size="12" StrokeWidth="2.5" Foreground="{DynamicResource warn}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Panel>
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource bg-300}" />
      <Setter Property="Foreground" Value="{DynamicResource ink}" />
    </Style>
    <Style Selector="^:current">
      <Setter Property="Background" Value="{DynamicResource secondary-soft}" />
      <Setter Property="Foreground" Value="{DynamicResource secondary}" />
    </Style>
    <Style Selector="^:caution">
      <Setter Property="Foreground" Value="{DynamicResource warn}" />
    </Style>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type c:GsSideRail}" TargetType="c:GsSideRail">
    <Setter Property="Width" Value="{DynamicResource rail-width}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{DynamicResource bg-100}" BorderBrush="{DynamicResource line-100}" BorderThickness="0,0,1,0" Padding="0,16">
          <!-- In the order they're seen, so Tab goes down the rail: the mark, the pages, then Settings at the bottom -->
          <Grid RowDefinitions="Auto,*,Auto">
            <Panel Grid.Row="0" Width="40" Height="40" Margin="0,0,0,12" ToolTip.Tip="GameSync">
              <c:GsIcon Icon="logo" Size="22" StrokeWidth="2" Foreground="{DynamicResource primary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Panel>
            <ItemsControl Grid.Row="1" ItemsSource="{TemplateBinding TopItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="c:RailItem">
                  <StackPanel HorizontalAlignment="Center">
                    <Border Width="28" Height="1" Background="{DynamicResource line-100}" Margin="0,8" IsVisible="{Binding Separator}" />
                    <c:GsRailButton Icon="{Binding Icon}" Margin="0,4" HorizontalAlignment="Center"
                                    ToolTip.Tip="{Binding FullLabel}" AutomationProperties.Name="{Binding FullLabel}"
                                    DotBrush="{Binding PlainDot, Converter={x:Static c:TokenBrushConverter.Instance}}" IsCaution="{Binding IsCaution}"
                                    Command="{Binding $parent[c:GsSideRail].PickCommand}" CommandParameter="{Binding Id}">
                      <c:GsRailButton.IsCurrent>
                        <MultiBinding Converter="{x:Static c:AllEqualConverter.Instance}">
                          <Binding Path="Id" />
                          <Binding Path="$parent[c:GsSideRail].Current" />
                        </MultiBinding>
                      </c:GsRailButton.IsCurrent>
                    </c:GsRailButton>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl Grid.Row="2" ItemsSource="{TemplateBinding BottomItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="c:RailItem">
                  <c:GsRailButton Icon="{Binding Icon}" Margin="0,4" HorizontalAlignment="Center"
                                  ToolTip.Tip="{Binding FullLabel}" AutomationProperties.Name="{Binding FullLabel}"
                                  DotBrush="{Binding PlainDot, Converter={x:Static c:TokenBrushConverter.Instance}}" IsCaution="{Binding IsCaution}"
                                  Command="{Binding $parent[c:GsSideRail].PickCommand}" CommandParameter="{Binding Id}">
                    <c:GsRailButton.IsCurrent>
                      <MultiBinding Converter="{x:Static c:AllEqualConverter.Instance}">
                        <Binding Path="Id" />
                        <Binding Path="$parent[c:GsSideRail].Current" />
                      </MultiBinding>
                    </c:GsRailButton.IsCurrent>
                  </c:GsRailButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- Scroll bars (KAN-57): a round thumb in the theme's ink on a clear track, thin until the pointer is over the bar,
       no arrow buttons; a click on the track still pages. Every ScrollViewer takes it, Fluent's included. -->
  <ControlTheme x:Key="GsScrollThumb" TargetType="Thumb">
    <Setter Property="Background" Value="{DynamicResource ink-faint}" />
    <Setter Property="Opacity" Value="0.55" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="999" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource ink-muted}" />
      <Setter Property="Opacity" Value="0.9" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="Background" Value="{DynamicResource primary}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="GsScrollPage" TargetType="RepeatButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
    <Setter Property="Cursor" Value="Arrow" />
    <Setter Property="Background" Value="Transparent" />
    <Style Selector="^:vertical">
      <Setter Property="Width" Value="12" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}">
            <Track Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value, Mode=TwoWay}"
                   ViewportSize="{TemplateBinding ViewportSize}" Orientation="Vertical" IsDirectionReversed="True"
                   DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}">
              <Track.DecreaseButton>
                <RepeatButton Name="PART_PageUpButton" Theme="{StaticResource GsScrollPage}" />
              </Track.DecreaseButton>
              <Track.IncreaseButton>
                <RepeatButton Name="PART_PageDownButton" Theme="{StaticResource GsScrollPage}" />
              </Track.IncreaseButton>
              <Thumb Name="PART_Thumb" Theme="{StaticResource GsScrollThumb}" HorizontalAlignment="Center" MinHeight="24" />
            </Track>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="^:vertical /template/ Thumb#PART_Thumb">
      <Setter Property="Width" Value="6" />
    </Style>
    <Style Selector="^:vertical:pointerover /template/ Thumb#PART_Thumb">
      <Setter Property="Width" Value="10" />
    </Style>
    <Style Selector="^:horizontal">
      <Setter Property="Height" Value="12" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}">
            <Track Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value, Mode=TwoWay}"
                   ViewportSize="{TemplateBinding ViewportSize}" Orientation="Horizontal"
                   DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}">
              <Track.DecreaseButton>
                <RepeatButton Name="PART_PageUpButton" Theme="{StaticResource GsScrollPage}" />
              </Track.DecreaseButton>
              <Track.IncreaseButton>
                <RepeatButton Name="PART_PageDownButton" Theme="{StaticResource GsScrollPage}" />
              </Track.IncreaseButton>
              <Thumb Name="PART_Thumb" Theme="{StaticResource GsScrollThumb}" VerticalAlignment="Center" MinWidth="24" />
            </Track>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="^:horizontal /template/ Thumb#PART_Thumb">
      <Setter Property="Height" Value="6" />
    </Style>
    <Style Selector="^:horizontal:pointerover /template/ Thumb#PART_Thumb">
      <Setter Property="Height" Value="10" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
