<!-- The design system's components as control themes (design/system/components/bundle.css is the spec). -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:GameSync.UI.Controls">

  <!-- Focus: a 2px primary ring offset by 2px, shown for keyboard focus (A11Y-02). -->
  <FocusAdornerTemplate x:Key="PillFocus">
    <Border BorderBrush="{DynamicResource primary}" BorderThickness="2" CornerRadius="999" Margin="-4" />
  </FocusAdornerTemplate>
  <FocusAdornerTemplate x:Key="RoundedFocus">
    <Border BorderBrush="{DynamicResource primary}" BorderThickness="2" CornerRadius="12" Margin="-4" />
  </FocusAdornerTemplate>
  <FocusAdornerTemplate x:Key="SmallFocus">
    <Border BorderBrush="{DynamicResource primary}" BorderThickness="2" CornerRadius="8" Margin="-4" />
  </FocusAdornerTemplate>

  <!-- Button -->
  <ControlTheme x:Key="{x:Type c:GsButton}" TargetType="c:GsButton">
    <Setter Property="Height" Value="{DynamicResource control-height}" />
    <Setter Property="Padding" Value="20,0" />
    <!-- A pill is half its height round: with the background under the border, a larger radius draws an ellipse. -->
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Background" Value="{DynamicResource bg-300}" />
    <Setter Property="BorderBrush" Value="{DynamicResource edge-control}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource ink}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FocusAdorner" Value="{StaticResource PillFocus}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                BackgroundSizing="OuterBorderEdge" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
            <c:GsIcon Icon="{TemplateBinding Icon}" Size="{TemplateBinding IconSize}" VerticalAlignment="Center"
                      IsVisible="{Binding $parent[c:GsButton].Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" />
            <c:GsIcon Icon="{TemplateBinding IconAfter}" Size="16" VerticalAlignment="Center"
                      IsVisible="{Binding $parent[c:GsButton].IconAfter, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource bg-400}" />
    </Style>
    <Style Selector="^.primary">
      <Setter Property="Background" Value="{DynamicResource primary}" />
      <Setter Property="Foreground" Value="{DynamicResource on-primary}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="^.primary:pointerover">
      <Setter Property="Background" Value="{DynamicResource primary-strong}" />
    </Style>
    <Style Selector="^.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource ink-muted}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="12,0" />
    </Style>
    <Style Selector="^.ghost:pointerover">
      <Setter Property="Background" Value="{DynamicResource bg-300}" />
      <Setter Property="Foreground" Value="{DynamicResource ink}" />
    </Style>
    <Style Selector="^.danger">
      <Setter Property="Background" Value="{DynamicResource danger-soft}" />
      <Setter Property="Foreground" Value="{DynamicResource danger}" />
    </Style>
    <Style Selector="^.sm">
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="IconSize" Value="16" />
    </Style>
    <Style Selector="^.ghost.sm">
      <Setter Property="Padding" Value="12,0" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
  </ControlTheme>

  <!-- IconButton -->
  <ControlTheme x:Key="{x:Type c:GsIconButton}" TargetType="c:GsIconButton">
    <Setter Property="Width" Value="{DynamicResource control-height}" />
    <Setter Property="Height" Value="{DynamicResource control-height}" />
    <Setter Property="Background" Value="{DynamicResource bg-300}" />
    <Setter Property="BorderBrush" Value="{DynamicResource edge-control}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource ink}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FocusAdorner" Value="{StaticResource PillFocus}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                BackgroundSizing="OuterBorderEdge" CornerRadius="999">
          <c:GsIcon Icon="{TemplateBinding Icon}" Size="{TemplateBinding IconSize}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource bg-400}" />
    </Style>
    <Style Selector="^.sm">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="IconSize" Value="16" />
    </Style>
    <Style Selector="^.glass">
      <Setter Property="Background" Value="{DynamicResource glass}" />
      <Setter Property="BorderBrush" Value="{DynamicResource glass-edge}" />
      <Setter Property="Foreground" Value="{DynamicResource on-art}" />
    </Style>
    <Style Selector="^.glass:pointerover">
      <Setter Property="Background" Value="{DynamicResource art-scrim}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
  </ControlTheme>

  <!-- Card: in Glossy, a hairline edge and a lit top edge (lift) over the backdrop; both are clear in Solid -->
  <ControlTheme x:Key="{x:Type c:GsCard}" TargetType="c:GsCard">
    <Setter Property="Background" Value="{DynamicResource bg-200}" />
    <Setter Property="BorderBrush" Value="{DynamicResource edge-card}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource radius-lg}" />
    <Setter Property="Padding" Value="20" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                BackgroundSizing="OuterBorderEdge" BoxShadow="{DynamicResource lift-card}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
          <DockPanel>
            <Grid Name="PART_Header" DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,16" IsVisible="False">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Classes="card-title" Text="{TemplateBinding Title}" TextWrapping="Wrap" />
                <TextBlock Name="PART_Subtitle" Classes="caption muted" Text="{TemplateBinding Subtitle}" Margin="0,2,0,0" TextWrapping="Wrap" IsVisible="False" />
              </StackPanel>
              <ContentPresenter Grid.Column="1" Content="{TemplateBinding Action}" VerticalAlignment="Center" Margin="12,0,0,0" />
            </Grid>
            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
          </DockPanel>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:header /template/ Grid#PART_Header">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:subtitle /template/ TextBlock#PART_Subtitle">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </ControlTheme>

  <!-- StatusBadge: status colours never follow the theme -->
  <ControlTheme x:Key="{x:Type c:GsStatusBadge}" TargetType="c:GsStatusBadge">
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="8,0,10,0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="999" Padding="{TemplateBinding Padding}">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <c:GsIcon Icon="{TemplateBinding IconName}" Size="14" StrokeWidth="2" VerticalAlignment="Center" />
            <TextBlock Text="{TemplateBinding Text}" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:ok">
      <Setter Property="Background" Value="{DynamicResource ok-soft}" />
      <Setter Property="Foreground" Value="{DynamicResource ok}" />
    </Style>
    <Style Selector="^:warn">
      <Setter Property="Background" Value="{DynamicResource warn-soft}" />
      <Setter Property="Foreground" Value="{DynamicResource warn}" />
    </Style>
    <Style Selector="^:play">
      <Setter Property="Background" Value="{DynamicResource play-soft}" />
      <Setter Property="Foreground" Value="{DynamicResource play}" />
    </Style>
    <Style Selector="^:danger">
      <Setter Property="Background" Value="{DynamicResource danger-soft}" />
      <Setter Property="Foreground" Value="{DynamicResource danger}" />
    </Style>
    <Style Selector="^:neutral">
      <Setter Property="Background" Value="{DynamicResource bg-300}" />
      <Setter Property="Foreground" Value="{DynamicResource neutral}" />
    </Style>
    <Style Selector="^:plain">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Height" Value="NaN" />
    </Style>
    <!-- On cover art: a deep tint that keeps 4.5:1 over any art, in both surfaces -->
    <Style Selector="^.art:ok">
      <Setter Property="Background" Value="{DynamicResource ok-art}" />
    </Style>
    <Style Selector="^.art:warn">
      <Setter Property="Background" Value="{DynamicResource warn-art}" />
    </Style>
    <Style Selector="^.art:play">
      <Setter Property="Background" Value="{DynamicResource play-art}" />
    </Style>
    <Style Selector="^.art:danger">
      <Setter Property="Background" Value="{DynamicResource danger-art}" />
    </Style>
    <Style Selector="^.art:neutral">
      <Setter Property="Background" Value="{DynamicResource neutral-art}" />
    </Style>
  </ControlTheme>

  <!-- Tag -->
  <ControlTheme x:Key="{x:Type c:GsTag}" TargetType="c:GsTag">
    <Setter Property="Background" Value="{DynamicResource bg-300}" />
    <Setter Property="Foreground" Value="{DynamicResource ink-muted}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="999" Height="18" Padding="7,0">
          <TextBlock Text="{TemplateBinding Text, Converter={x:Static c:UpperConverter.Instance}}" FontSize="10" LineHeight="14"
                     FontWeight="SemiBold" LetterSpacing="0.8" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- Note -->
  <ControlTheme x:Key="{x:Type c:GsNote}" TargetType="c:GsNote">
    <Setter Property="Foreground" Value="{DynamicResource ink-muted}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="Auto,*">
          <c:GsIcon Icon="{TemplateBinding Icon}" Size="16" VerticalAlignment="Top" />
          <TextBlock Grid.Column="1" Text="{TemplateBinding Text}" Margin="8,0,0,0" FontSize="12" LineHeight="16" TextWrapping="Wrap" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- Switch -->
  <ControlTheme x:Key="{x:Type c:GsSwitch}" TargetType="c:GsSwitch">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource bg-300}" />
    <Setter Property="BorderBrush" Value="{DynamicResource line-200}" />
    <Setter Property="FocusAdorner" Value="{StaticResource PillFocus}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="999">
          <Ellipse Name="PART_Knob" Width="15" Height="15" Margin="2,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{DynamicResource ink-muted}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:checked">
      <Setter Property="Background" Value="{DynamicResource primary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource primary}" />
    </Style>
    <Style Selector="^:checked /template/ Ellipse#PART_Knob">
      <Setter Property="Margin" Value="20,0,0,0" />
      <Setter Property="Fill" Value="{DynamicResource on-primary}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
  </ControlTheme>

  <!-- CheckBox: a primary fill when ticked; the border meets 3:1 in every theme -->
  <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FocusAdorner" Value="{StaticResource SmallFocus}" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Orientation="Horizontal" Spacing="8" Background="{TemplateBinding Background}">
          <Border Name="PART_Box" Width="18" Height="18" CornerRadius="{DynamicResource radius-sm}" BorderThickness="1.5"
                  BorderBrush="{DynamicResource line-200}" Background="Transparent" VerticalAlignment="Center">
            <Panel>
              <Path Name="PART_Check" Data="M3.5 9 L7 12.5 L14 5.5" Stroke="{DynamicResource on-primary}" StrokeThickness="2"
                    StrokeLineCap="Round" StrokeJoin="Round" IsVisible="False" Margin="-1.5" />
              <Rectangle Name="PART_Dash" Width="9" Height="2" Fill="{DynamicResource on-primary}" IsVisible="False" />
            </Panel>
          </Border>
          <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center"
                            IsVisible="{Binding $parent[CheckBox].Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:checked /template/ Border#PART_Box">
      <Setter Property="Background" Value="{DynamicResource primary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource primary}" />
    </Style>
    <Style Selector="^:checked /template/ Path#PART_Check">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:indeterminate /template/ Border#PART_Box">
      <Setter Property="Background" Value="{DynamicResource primary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource primary}" />
    </Style>
    <Style Selector="^:indeterminate /template/ Rectangle#PART_Dash">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
  </ControlTheme>

  <!-- ProgressBar and GsProgress -->
  <ControlTheme x:Key="{x:Type ProgressBar}" TargetType="ProgressBar">
    <Setter Property="Height" Value="6" />
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="Background" Value="{DynamicResource bg-400}" />
    <Setter Property="Foreground" Value="{DynamicResource primary}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="999" ClipToBounds="True">
          <Border Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="999" HorizontalAlignment="Left" />
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type c:GsProgress}" TargetType="c:GsProgress">
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="mono-small muted" Text="{TemplateBinding Label}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1" Classes="mono-small muted" Text="{TemplateBinding Right}" Margin="12,0,0,0" />
          </Grid>
          <ProgressBar Minimum="0" Maximum="100" Value="{TemplateBinding Value}" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- SettingsRow -->
  <ControlTheme x:Key="{x:Type c:GsSettingsRow}" TargetType="c:GsSettingsRow">
    <Setter Property="MinHeight" Value="56" />
    <Setter Property="Padding" Value="0,12" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
        <Grid Name="PART_Grid" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="{TemplateBinding Padding}">
          <StackPanel Name="PART_Text" Spacing="2" VerticalAlignment="Center" Margin="0,0,20,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Name="PART_Title" Text="{TemplateBinding Title}" FontWeight="Medium" TextWrapping="Wrap" VerticalAlignment="Center" />
              <c:GsTag Text="{TemplateBinding TagText}" IsVisible="{Binding $parent[c:GsSettingsRow].TagText, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
            <TextBlock Classes="caption muted" Text="{TemplateBinding Description}" TextWrapping="Wrap" MaxWidth="460" HorizontalAlignment="Left"
                       IsVisible="{Binding $parent[c:GsSettingsRow].Description, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
          <ContentPresenter Name="PART_Control" Grid.Column="1" Content="{TemplateBinding Content}" VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:stack /template/ ContentPresenter#PART_Control">
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Grid.Row" Value="1" />
      <Setter Property="Grid.ColumnSpan" Value="2" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="0,12,0,0" />
    </Style>
    <Style Selector="^:disabled /template/ TextBlock#PART_Title">
      <Setter Property="Foreground" Value="{DynamicResource ink-muted}" />
    </Style>
  </ControlTheme>

  <!-- PillTabs -->
  <ControlTheme x:Key="PillTabItem" TargetType="ListBoxItem">
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource bg-400}" />
    <Setter Property="Foreground" Value="{DynamicResource ink-muted}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FocusAdorner" Value="{StaticResource PillFocus}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="999" Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource ink}" />
    </Style>
    <Style Selector="^:selected">
      <Setter Property="Background" Value="{DynamicResource secondary-soft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource secondary-soft}" />
      <Setter Property="Foreground" Value="{DynamicResource ink}" />
    </Style>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type c:GsPillTabs}" TargetType="c:GsPillTabs">
    <Setter Property="ItemContainerTheme" Value="{StaticResource PillTabItem}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" Spacing="8" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="ItemTemplate">
      <DataTemplate x:DataType="c:NavItem">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <c:GsIcon Classes="selectable" Icon="{Binding Icon}" Size="16" VerticalAlignment="Center" IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
          <Border Background="{DynamicResource secondary}" CornerRadius="999" Padding="6,0" VerticalAlignment="Center"
                  IsVisible="{Binding Count, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding Count}" Foreground="{DynamicResource on-secondary}" FontFamily="{DynamicResource font-mono}" FontSize="11" LineHeight="16" FontWeight="Medium" />
          </Border>
        </StackPanel>
      </DataTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- SettingsNav -->
  <ControlTheme x:Key="SettingsNavItem" TargetType="ListBoxItem">
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ink-muted}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FocusAdorner" Value="{StaticResource RoundedFocus}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource radius-md}" Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" VerticalAlignment="Center"
                            HorizontalContentAlignment="Stretch" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource bg-300}" />
      <Setter Property="Foreground" Value="{DynamicResource ink}" />
    </Style>
    <Style Selector="^:selected">
      <Setter Property="Background" Value="{DynamicResource secondary-soft}" />
      <Setter Property="Foreground" Value="{DynamicResource ink}" />
    </Style>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type c:GsSettingsNav}" TargetType="c:GsSettingsNav">
    <Setter Property="ItemContainerTheme" Value="{StaticResource SettingsNavItem}" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Spacing="2" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="ItemTemplate">
      <DataTemplate x:DataType="c:NavItem">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <c:GsIcon Classes="selectable" Icon="{Binding Icon}" Size="18" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="12,0,0,0" VerticalAlignment="Center" />
          <Border Grid.Column="2" Background="{DynamicResource warn-soft}" CornerRadius="999" Padding="6,0" VerticalAlignment="Center"
                  IsVisible="{Binding Count, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding Count}" Foreground="{DynamicResource warn}" FontFamily="{DynamicResource font-mono}" FontSize="11" LineHeight="16" FontWeight="Medium" />
          </Border>
        </Grid>
      </DataTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- SideRail -->
  <ControlTheme x:Key="{x:Type c:GsRailButton}" TargetType="c:GsRailButton">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ink-faint}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{StaticResource RoundedFocus}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource radius-md}">
          <Panel>
            <c:GsIcon Icon="{TemplateBinding Icon}" Size="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Ellipse Width="12" Height="12" Fill="{DynamicResource dot-ring}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0"
                     IsVisible="{Binding $parent[c:GsRailButton].DotBrush, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <Ellipse Width="8" Height="8" Fill="{TemplateBinding DotBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,7,0"
                     IsVisible="{Binding $parent[c:GsRailButton].DotBrush, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource bg-300}" />
      <Setter Property="Foreground" Value="{DynamicResource ink}" />
    </Style>
    <Style Selector="^:current">
      <Setter Property="Background" Value="{DynamicResource secondary-soft}" />
      <Setter Property="Foreground" Value="{DynamicResource secondary}" />
    </Style>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type c:GsSideRail}" TargetType="c:GsSideRail">
    <Setter Property="Width" Value="{DynamicResource rail-width}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{DynamicResource bg-100}" BorderBrush="{DynamicResource line-100}" BorderThickness="0,0,1,0" Padding="0,16">
          <DockPanel>
            <Panel DockPanel.Dock="Top" Width="40" Height="40" Margin="0,0,0,12" ToolTip.Tip="GameSync">
              <c:GsIcon Icon="logo" Size="22" StrokeWidth="2" Foreground="{DynamicResource primary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Panel>
            <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{TemplateBinding BottomItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="c:RailItem">
                  <c:GsRailButton Icon="{Binding Icon}" Margin="0,4" HorizontalAlignment="Center"
                                  ToolTip.Tip="{Binding FullLabel}" AutomationProperties.Name="{Binding FullLabel}"
                                  DotBrush="{Binding Dot, Converter={x:Static c:TokenBrushConverter.Instance}}"
                                  Command="{Binding $parent[c:GsSideRail].PickCommand}" CommandParameter="{Binding Id}">
                    <c:GsRailButton.IsCurrent>
                      <MultiBinding Converter="{x:Static c:AllEqualConverter.Instance}">
                        <Binding Path="Id" />
                        <Binding Path="$parent[c:GsSideRail].Current" />
                      </MultiBinding>
                    </c:GsRailButton.IsCurrent>
                  </c:GsRailButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{TemplateBinding TopItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="c:RailItem">
                  <StackPanel HorizontalAlignment="Center">
                    <Border Width="28" Height="1" Background="{DynamicResource line-100}" Margin="0,8" IsVisible="{Binding Separator}" />
                    <c:GsRailButton Icon="{Binding Icon}" Margin="0,4" HorizontalAlignment="Center"
                                    ToolTip.Tip="{Binding FullLabel}" AutomationProperties.Name="{Binding FullLabel}"
                                    DotBrush="{Binding Dot, Converter={x:Static c:TokenBrushConverter.Instance}}"
                                    Command="{Binding $parent[c:GsSideRail].PickCommand}" CommandParameter="{Binding Id}">
                      <c:GsRailButton.IsCurrent>
                        <MultiBinding Converter="{x:Static c:AllEqualConverter.Instance}">
                          <Binding Path="Id" />
                          <Binding Path="$parent[c:GsSideRail].Current" />
                        </MultiBinding>
                      </c:GsRailButton.IsCurrent>
                    </c:GsRailButton>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DockPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
