<!-- Settings and dialogs: folder fields and lists, the dialog frame, and the theme and swatch pickers. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:GameSync.UI.Controls">

  <!-- FolderField -->
  <ControlTheme x:Key="{x:Type c:GsFolderField}" TargetType="c:GsFolderField">
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Border Name="PART_IconBox" Width="40" Height="40" CornerRadius="{DynamicResource radius-md}" Background="{DynamicResource bg-300}"
                    TextElement.Foreground="{DynamicResource ink-muted}">
              <c:GsIcon Icon="{TemplateBinding Icon}" Size="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="2" Margin="12,0" VerticalAlignment="Center">
              <TextBlock Text="{TemplateBinding Label}" FontWeight="Medium"
                         IsVisible="{Binding $parent[c:GsFolderField].Label, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <TextBlock Classes="mono" Text="{TemplateBinding Path}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{TemplateBinding Path}" />
              <TextBlock Classes="caption muted" Text="{TemplateBinding Meta}" TextWrapping="Wrap"
                         IsVisible="{Binding $parent[c:GsFolderField].Meta, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <c:GsButton Classes="sm" Content="{TemplateBinding ChangeLabel}" Command="{TemplateBinding ChangeCommand}" />
              <c:GsIconButton Classes="sm" Icon="folder" Label="Open in Explorer" Command="{TemplateBinding OpenCommand}" />
            </StackPanel>
          </Grid>
          <c:GsProgress Name="PART_Progress" Value="{TemplateBinding Progress}" Label="{TemplateBinding Message}" IsVisible="False" />
          <Border Name="PART_Message" CornerRadius="{DynamicResource radius-md}" Padding="12,8" IsVisible="False">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:GsIcon Name="PART_MessageIcon" Icon="unplug" Size="16" VerticalAlignment="Center" />
              <TextBlock Text="{TemplateBinding Message}" FontSize="12" LineHeight="16" FontWeight="Medium" TextWrapping="Wrap" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:moving /template/ c|GsProgress#PART_Progress">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:missing /template/ Border#PART_IconBox">
      <Setter Property="Background" Value="{DynamicResource warn-soft}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource warn}" />
    </Style>
    <Style Selector="^:missing /template/ Border#PART_Message">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="Background" Value="{DynamicResource warn-soft}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource warn}" />
    </Style>
    <Style Selector="^:refused /template/ Border#PART_IconBox">
      <Setter Property="Background" Value="{DynamicResource danger-soft}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource danger}" />
    </Style>
    <Style Selector="^:refused /template/ Border#PART_Message">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="Background" Value="{DynamicResource danger-soft}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource danger}" />
    </Style>
    <Style Selector="^:refused /template/ c|GsIcon#PART_MessageIcon">
      <Setter Property="Icon" Value="block" />
    </Style>
  </ControlTheme>

  <!-- FolderList -->
  <ControlTheme x:Key="{x:Type c:GsFolderList}" TargetType="c:GsFolderList">
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Spacing="8">
          <ItemsControl ItemsSource="{TemplateBinding Items}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="c:FolderItem">
                <Border Background="{DynamicResource bg-300}" CornerRadius="{DynamicResource radius-md}" MinHeight="44" Padding="12,6,6,6">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <c:GsIcon Icon="{Binding Icon}" Size="16" Foreground="{DynamicResource ink-muted}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                      <TextBlock Classes="mono" Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" />
                      <TextBlock Classes="caption muted" Text="{Binding Meta}" IsVisible="{Binding Meta, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                    <c:GsTag Grid.Column="2" Text="{Binding Tag}" Background="{DynamicResource bg-400}" Margin="0,0,8,0"
                             IsVisible="{Binding Tag, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <c:GsButton Grid.Column="3" Classes="ghost sm" Content="Remove"
                                Command="{Binding $parent[c:GsFolderList].RemoveCommand}" CommandParameter="{Binding}"
                                IsVisible="{Binding $parent[c:GsFolderList].RemoveCommand, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Name="PART_Empty" Text="{TemplateBinding Empty}" FontSize="13" Foreground="{DynamicResource ink-faint}" Margin="0,6" IsVisible="False" />
          <c:GsButton Classes="ghost sm" Icon="plus" Content="{TemplateBinding AddLabel}" Command="{TemplateBinding AddCommand}"
                      IsVisible="{Binding $parent[c:GsFolderList].AddCommand, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:empty /template/ TextBlock#PART_Empty">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </ControlTheme>

  <!-- Dialog: the only shadow in the app -->
  <ControlTheme x:Key="{x:Type c:GsDialog}" TargetType="c:GsDialog">
    <Setter Property="Width" Value="640" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{DynamicResource bg-200}" CornerRadius="16" BoxShadow="{DynamicResource shadow-dialog}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="24,24,24,16" Spacing="4">
              <TextBlock Classes="card-title" Text="{TemplateBinding Title}" TextWrapping="Wrap" />
              <TextBlock Classes="muted" Text="{TemplateBinding Subtitle}" TextWrapping="Wrap"
                         IsVisible="{Binding $parent[c:GsDialog].Subtitle, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource line-100}" BorderThickness="0,1,0,0" Padding="24,16,24,24" Margin="0,16,0,0">
              <ContentPresenter Content="{TemplateBinding Footer}" />
            </Border>
            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Margin="24,0" />
          </DockPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- ThemePicker: a live mini preview per preset, the chosen one ticked -->
  <ControlTheme x:Key="ThemeCardItem" TargetType="ListBoxItem">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FocusAdorner" Value="{DynamicResource RoundedFocus}" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Background="Transparent" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type c:GsThemePicker}" TargetType="c:GsThemePicker">
    <Setter Property="ItemContainerTheme" Value="{StaticResource ThemeCardItem}" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <c:ColumnsPanel Columns="7" Gap="12" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="ItemTemplate">
      <DataTemplate x:DataType="c:ThemeCard">
        <StackPanel Spacing="8" AutomationProperties.Name="{Binding Label}">
          <Panel>
            <c:GsThemeMini Tokens="{Binding Tokens}" />
            <Border Classes="theme-ring" Margin="-4" BorderThickness="2" CornerRadius="13" BorderBrush="Transparent" />
          </Panel>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Border Width="16" Height="16" CornerRadius="999" Background="{DynamicResource primary}" VerticalAlignment="Center"
                    IsVisible="{Binding $parent[ListBoxItem].IsSelected}">
              <c:GsIcon Icon="check" Size="11" StrokeWidth="3" Foreground="{DynamicResource on-primary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="{Binding Name}" FontSize="13" LineHeight="18" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </StackPanel>
      </DataTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- ColorSwatchPicker: each swatch in the tone it takes; the chosen one ringed in ink and ticked -->
  <ControlTheme x:Key="SwatchItem" TargetType="ListBoxItem">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FocusAdorner" Value="{DynamicResource PillFocus}" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Background="Transparent" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type c:GsSwatchPicker}" TargetType="c:GsSwatchPicker">
    <Setter Property="ItemContainerTheme" Value="{StaticResource SwatchItem}" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <WrapPanel ItemSpacing="6" LineSpacing="6" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="ItemTemplate">
      <DataTemplate x:DataType="c:SwatchCard">
        <Panel Width="38" Height="38" ToolTip.Tip="{Binding Name}" AutomationProperties.Name="{Binding Name}">
          <Ellipse Stroke="{DynamicResource ink}" StrokeThickness="2" IsVisible="{Binding $parent[ListBoxItem].IsSelected}" />
          <Ellipse Width="30" Height="30" Fill="{Binding FillBrush}" />
          <c:GsIcon Icon="check" Size="14" StrokeWidth="2.5" Foreground="{Binding OnFillBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                    IsVisible="{Binding $parent[ListBoxItem].IsSelected}" />
        </Panel>
      </DataTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
