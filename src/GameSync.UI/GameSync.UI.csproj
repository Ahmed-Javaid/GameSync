<Project Sdk="Microsoft.NET.Sdk">

  <!-- The screens, the theme engine and the styled components; GameSync.Tray.exe shows them. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <!-- The Glossy backdrop draws straight onto Skia (KAN-54, KAN-58); the same version the app ships. -->
    <PackageReference Include="Avalonia.Skia" Version="12.1.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GameSync.Core.Tests" />
    <InternalsVisibleTo Include="GameSync.Snapshots" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameSync.Host\GameSync.Host.csproj" />
  </ItemGroup>

  <!-- Onest and JetBrains Mono, from Google Fonts, under the SIL Open Font License; the licences ship beside the app. -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />
    <None Include="Assets\Fonts\OFL-*.txt" CopyToOutputDirectory="PreserveNewest" Link="Licences\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
