<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:GameSync.UI.Controls"
        xmlns:v="using:GameSync.UI.Views"
        xmlns:vm="using:GameSync.UI.ViewModels"
        x:Class="GameSync.UI.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="GameSync"
        Width="1280" Height="800" MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="32"
        WindowDecorationsTheme="{StaticResource GsWindowDecorations}">
  <!-- GameSync's window: the side rail and its pages. Closing it leaves GameSync running in the tray. In Glossy, a
       blurred, darkened copy of a game's art sits behind them (LOOK-17). The page reaches up into the title bar, which is
       GameSync's own (Styles/Window.axaml): a strip to drag by and three caption buttons in the theme's ink. -->
  <Panel>
    <!-- The backdrop; a new game's colours glow in on it like a light behind frosted glass (KAN-54) -->
    <c:GsBackdrop x:Name="Art" IsHitTestVisible="False" />
    <v:Shell x:Name="Frame" />
    <!-- A change of look comes through the window as it looked, from where the person clicked (KAN-76) -->
    <c:GsLookCurtain x:Name="Curtain" />
  </Panel>
</Window>
