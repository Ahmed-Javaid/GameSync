<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:GameSync.UI.Controls"
             xmlns:vm="using:GameSync.UI.ViewModels"
             xmlns:v="using:GameSync.UI.Views"
             x:Class="GameSync.UI.Views.Shell"
             x:DataType="vm:ShellViewModel">
  <DockPanel>
    <c:GsSideRail DockPanel.Dock="Left" Items="{Binding Rail}" Current="{Binding Current}" NavigateCommand="{Binding NavigateCommand}" />
    <Panel>
      <!-- The title bar's strip: dragging it moves the window. The rail runs to the top; the page starts a little under
           the strip, whose lower part is the page's own clear margin, so that drags too. -->
      <Border VerticalAlignment="Top" Height="{Binding $parent[v:Shell].TitleBarHeight}" Background="Transparent"
              WindowDecorationProperties.ElementRole="TitleBar" />
      <ContentControl Content="{Binding Page}" Margin="{Binding $parent[v:Shell].PageMargin}" />
    </Panel>
  </DockPanel>
</UserControl>
