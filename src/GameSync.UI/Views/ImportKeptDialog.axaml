<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:GameSync.UI.Controls"
             xmlns:vm="using:GameSync.UI.ViewModels"
             xmlns:sys="using:System"
             x:Class="GameSync.UI.Views.ImportKeptDialog"
             x:DataType="vm:ImportKeptViewModel"
             Width="{DynamicResource dw-640}">
  <!-- Import kept saves (design system → ImportKeptSavesDialog, BAK-19): the folder holding copies of a game's saves kept
       by hand, each copy by name, Import. Each becomes a named save on every PC, never current by itself; the folders are
       never changed. -->
  <Border Background="{DynamicResource surface-dialog}" BorderBrush="{DynamicResource edge-dialog}" BorderThickness="1" BackgroundSizing="OuterBorderEdge"
          CornerRadius="16" BoxShadow="{DynamicResource shadow-dialog}" ClipToBounds="True">
    <DockPanel>
      <Border DockPanel.Dock="Top" Padding="24,20,24,8">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Classes="card-title" Text="Import kept saves" />
            <TextBlock Classes="muted" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <c:GsIconButton Grid.Column="1" Classes="sm" Icon="x" Label="Close Import kept saves" Command="{Binding CloseCommand}" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <!-- Foot: the count and the promise, Cancel and Import; done, what happened and Done -->
      <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource line-100}" BorderThickness="0,1,0,0" Padding="24,14">
        <Panel>
          <StackPanel Spacing="12" IsVisible="{Binding !Done}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding CanImport}">
              <TextBlock Classes="mono-small muted" Text="{Binding Summary}" TextWrapping="Wrap" />
              <TextBlock Grid.Column="1" Classes="mono-small muted" Text="{Binding SizeText}" />
            </Grid>
            <c:GsNote Icon="shield" Text="Your folders are never changed. Each copy becomes a named save on every PC, kept aside: never current by itself." />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <c:GsButton Classes="ghost" Content="Cancel" Command="{Binding CloseCommand}" />
              <c:GsButton Classes="primary" Icon="download" Content="{Binding ImportLabel}" Command="{Binding ImportCommand}" IsEnabled="{Binding CanImport}"
                          IsBusy="{Binding Importing}" BusyText="Importing" />
            </StackPanel>
          </StackPanel>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" IsVisible="{Binding Done}">
            <Border Background="{DynamicResource primary-soft}" CornerRadius="{DynamicResource radius-md}" Padding="16,12">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <c:GsIcon Icon="check" Size="20" Foreground="{DynamicResource primary}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding DoneText}" />
                  <TextBlock Classes="caption muted" TextWrapping="Wrap" Text="They're under Named saves, on every PC. Restore brings one back, keeping your files now first." />
                </StackPanel>
              </Grid>
            </Border>
            <c:GsButton Grid.Column="1" Classes="primary" Content="Done" Command="{Binding CloseCommand}" VerticalAlignment="Center" />
          </Grid>
        </Panel>
      </Border>

      <StackPanel Margin="24,12,24,20" Spacing="16">
        <!-- Pick: what a kept copy looks like -->
        <StackPanel Spacing="16" IsVisible="{Binding Picking}">
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Intro}" />
          <c:GsButton Icon="folder" Content="Choose the folder…" Click="PickFolder" HorizontalAlignment="Left" />
        </StackPanel>

        <!-- The folder, and how many kept copies it holds -->
        <Border Background="{DynamicResource surface-well}" BorderBrush="{DynamicResource edge-well}" BorderThickness="1" BackgroundSizing="OuterBorderEdge"
                CornerRadius="{DynamicResource radius-md}" Padding="12,10,8,10" IsVisible="{Binding ShowsFolder}">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
            <Border Width="40" Height="40" CornerRadius="{DynamicResource radius-md}" Background="{DynamicResource bg-300}">
              <c:GsIcon Icon="folder" Size="18" Foreground="{DynamicResource ink-muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
              <TextBlock Classes="mono" Text="{Binding Folder}" TextTrimming="LeadingCharacterEllipsis" ToolTip.Tip="{Binding Folder}" />
              <TextBlock Classes="caption muted" Text="{Binding FoundText}" IsVisible="{Binding Reviewing}" />
              <c:GsNote Icon="search" Text="Looking at the copies in it" IsBusy="True" IsVisible="{Binding Looking}" />
            </StackPanel>
            <c:GsButton Grid.Column="2" Classes="sm" Content="Change…" Click="PickFolder" IsEnabled="{Binding !Busy}" VerticalAlignment="Center" />
            <c:GsIconButton Grid.Column="3" Classes="sm" Icon="folder" Label="Open in Explorer" Command="{Binding OpenCommand}" VerticalAlignment="Center" />
          </Grid>
        </Border>

        <!-- Which of the game's places they copy, when it has more than one -->
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" IsVisible="{Binding HasRoots}">
          <TextBlock Classes="overline faint" Text="THEY'RE COPIES OF" VerticalAlignment="Center" />
          <c:GsButton Grid.Column="1" Classes="sm" IconAfter="chevronDown" Content="{Binding RootLabel}" HorizontalAlignment="Left"
                      AutomationProperties.Name="{Binding RootLabel, StringFormat='They are copies of: {0}'}">
            <c:GsButton.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft">
                <ItemsControl ItemsSource="{Binding Roots}" Margin="4">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:Choice">
                      <c:GsButton Classes="ghost sm" Content="{Binding Label}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="CloseFlyout"
                                  Command="{Binding $parent[UserControl].((vm:ImportKeptViewModel)DataContext).SelectRootCommand}" CommandParameter="{Binding Id}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Flyout>
            </c:GsButton.Flyout>
          </c:GsButton>
        </Grid>

        <!-- Each copy by name, newest last; a copy the same as another says so, stored once -->
        <ScrollViewer MaxHeight="300" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding Reviewing}">
          <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:KeptItem">
                <Border Padding="12,8" CornerRadius="{DynamicResource radius-md}" AutomationProperties.Name="{Binding}">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <c:GsIcon Icon="pin" Size="16" Foreground="{DynamicResource ink-muted}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="mono-small muted" Text="{Binding Meta}" />
                    </StackPanel>
                    <c:GsTag Grid.Column="2" Text="{Binding SameText}" Background="{DynamicResource bg-400}" IsVisible="{Binding HasSame}" VerticalAlignment="Center"
                             ToolTip.Tip="{Binding Same, StringFormat='Its files are the same as {0}, so they are stored once'}" />
                    <TextBlock Grid.Column="2" Classes="mono-small muted" Text="{Binding Size}" IsVisible="{Binding !HasSame}" VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <ItemsControl ItemsSource="{Binding Skipped}" IsVisible="{Binding HasSkipped}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="sys:String">
              <c:GsNote Icon="alert" Foreground="{DynamicResource warn}" Text="{Binding}" Margin="0,0,0,6" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <c:GsNote Icon="alert" Foreground="{DynamicResource danger}" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>
    </DockPanel>
  </Border>
</UserControl>
