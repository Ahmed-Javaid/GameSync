<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:GameSync.UI.Controls"
             xmlns:vm="using:GameSync.UI.ViewModels"
             xmlns:v="using:GameSync.UI.Views"
             x:Class="GameSync.UI.Views.LibraryPage"
             x:DataType="vm:LibraryViewModel">
  <!-- The game library, like Steam's (design system → LibraryScreen): every game by name in a list on the left, with the
       search, the sort, Installed only and favourites first; the covers, or the page of the game picked, on the right. -->
  <Grid ColumnDefinitions="272,*" ColumnSpacing="16" Margin="24,20">

    <!-- The list -->
    <c:GsCard Padding="12" AutomationProperties.Name="Your games">
      <DockPanel>
        <TextBox Name="SearchBox" DockPanel.Dock="Top" Classes="search clearButton" PlaceholderText="Search your games"
                 Text="{Binding Search}" AutomationProperties.Name="Search your games">
          <TextBox.InnerLeftContent>
            <c:GsIcon Icon="search" Size="16" Margin="12,0,0,0" Foreground="{DynamicResource ink-faint}" VerticalAlignment="Center" />
          </TextBox.InnerLeftContent>
          <TextBox.InnerRightContent>
            <Panel VerticalAlignment="Center">
              <Border BorderBrush="{DynamicResource line-200}" BorderThickness="1" CornerRadius="4" Padding="5,0" Margin="0,0,8,0" VerticalAlignment="Center"
                      IsVisible="{Binding ShowsShortcut}">
                <TextBlock Text="Ctrl F" FontFamily="{DynamicResource font-mono}" FontSize="11" LineHeight="16" FontWeight="Medium" Foreground="{DynamicResource ink-faint}" />
              </Border>
              <!-- While searching, how many match, before the clear button -->
              <TextBlock Classes="caption faint" Text="{Binding SearchCount}" IsVisible="{Binding !ShowsShortcut}" Margin="0,0,4,0" VerticalAlignment="Center"
                         FontFamily="{DynamicResource font-mono}" />
            </Panel>
          </TextBox.InnerRightContent>
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding OpenFirstMatchCommand}" />
          </TextBox.KeyBindings>
        </TextBox>

        <!-- Installed only (KAN-47), kept on this PC like the order; the list's headings count the games -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="4,10,0,6">
          <CheckBox Content="Installed" AutomationProperties.Name="Installed only" IsChecked="{Binding InstalledOnly}" FontSize="12" MinWidth="0" Padding="6,0,0,0" VerticalAlignment="Center"
                    ToolTip.Tip="Only the games installed on this PC, in the list and the covers" />
          <c:GsButton Grid.Column="1" Classes="ghost sm" IconAfter="chevronDown" Content="{Binding SortLabel}"
                      AutomationProperties.Name="{Binding SortName}">
            <c:GsButton.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem Header="Recently played" ToggleType="CheckBox" IsChecked="{Binding SortsByRecent, Mode=OneWay}"
                          Command="{Binding SortByCommand}" CommandParameter="RecentlyPlayed" />
                <MenuItem Header="Name" ToggleType="CheckBox" IsChecked="{Binding SortsByName, Mode=OneWay}"
                          Command="{Binding SortByCommand}" CommandParameter="Name" />
                <MenuItem Header="Hours played" ToggleType="CheckBox" IsChecked="{Binding SortsByHours, Mode=OneWay}"
                          Command="{Binding SortByCommand}" CommandParameter="HoursPlayed" />
                <MenuItem Header="Recently added" ToggleType="CheckBox" IsChecked="{Binding SortsByAdded, Mode=OneWay}"
                          Command="{Binding SortByCommand}" CommandParameter="RecentlyAdded" />
              </MenuFlyout>
            </c:GsButton.Flyout>
          </c:GsButton>
        </Grid>

        <ScrollViewer Name="ListScroller" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-8,0" Padding="0,0,8,0">
          <Panel>
            <TextBlock Classes="caption faint" Text="{Binding Nothing}" TextWrapping="Wrap" Margin="8,8" IsVisible="{Binding HasNothing}" />
            <ItemsControl Name="List" ItemsSource="{Binding ListItems}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="2" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.DataTemplates>
                <DataTemplate DataType="vm:GameListHeading">
                  <c:GsListHeading Label="{Binding Label}" Count="{Binding CountText}" IsOpen="{Binding IsOpen}" Margin="0,8,0,0"
                                   AutomationProperties.Name="{Binding}"
                                   Command="{Binding $parent[v:LibraryPage].((vm:LibraryViewModel)DataContext).ToggleGroupCommand}"
                                   CommandParameter="{Binding GroupId}" />
                </DataTemplate>
                <DataTemplate DataType="vm:GameListRow">
                  <c:GsGameRow Title="{Binding Game.Title}" Art="{Binding Game.SmallArt}" Status="{Binding Game.Status}" StatusLabel="{Binding Game.StatusLabel}" MarkLabel="{Binding Game.MarkLabel}"
                               ShowsStatus="{Binding Game.ShowsListStatus}" IsInstalled="{Binding Game.Installed}"
                               AutomationProperties.Name="{Binding Game.SpokenName}" ToolTip.Tip="{Binding Game.SpokenName}"
                               Command="{Binding $parent[v:LibraryPage].((vm:LibraryViewModel)DataContext).OpenCommand}" CommandParameter="{Binding Game.Id}">
                    <c:GsGameRow.IsCurrent>
                      <MultiBinding Converter="{x:Static c:AllEqualConverter.Instance}">
                        <Binding Path="Game.Id" />
                        <Binding Path="$parent[v:LibraryPage].((vm:LibraryViewModel)DataContext).Selected" />
                      </MultiBinding>
                    </c:GsGameRow.IsCurrent>
                    <c:GsGameRow.ContextMenu>
                      <ContextMenu IsVisible="{Binding Game.HasMenu}">
                        <MenuItem Header="Play" Command="{Binding Game.PlayCommand}" IsVisible="{Binding Game.PlayCommand, Converter={x:Static ObjectConverters.IsNotNull}}">
                          <MenuItem.Icon><c:GsIcon Icon="play" Size="16" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator IsVisible="{Binding Game.PlayCommand, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <MenuItem Header="{Binding Game.FavouriteLabel}" Command="{Binding Game.ToggleFavourite}">
                          <MenuItem.Icon><c:GsIcon Icon="star" Size="16" Filled="{Binding Game.IsFavourite}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{Binding Game.HideLabel}" Command="{Binding Game.ToggleHidden}" />
                        <Separator IsVisible="{Binding Game.HasProperties}" />
                        <MenuItem Header="Properties" Command="{Binding Game.PropertiesCommand}" IsVisible="{Binding Game.HasProperties}">
                          <MenuItem.Icon><c:GsIcon Icon="settings" Size="16" /></MenuItem.Icon>
                        </MenuItem>
                      </ContextMenu>
                    </c:GsGameRow.ContextMenu>
                  </c:GsGameRow>
                </DataTemplate>
              </ItemsControl.DataTemplates>
            </ItemsControl>
          </Panel>
        </ScrollViewer>
      </DockPanel>
    </c:GsCard>

    <!-- The covers, or the game picked -->
    <Panel Grid.Column="1">
      <DockPanel IsVisible="{Binding ShowsCovers}">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" Margin="0,0,0,16">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" FontSize="15" LineHeight="20" FontWeight="SemiBold" />
            <TextBlock Classes="caption faint" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <c:GsPillTabs Grid.Column="1" ItemsSource="{Binding Tabs}" SelectedId="{Binding SelectedTab, Mode=TwoWay}" AutomationProperties.Name="Library view"
                        HorizontalAlignment="Center" />
          <!-- Add game: a game or folder of the person's own (LIB-13), in its dialog -->
          <c:GsButton Grid.Column="2" Icon="plus" Content="Add game" HorizontalAlignment="Right" Command="{Binding AddGameCommand}" IsVisible="{Binding CanAddGame}"
                      ToolTip.Tip="A game GameSync didn't find, or any folder to keep in step, like a game server's world" />

        </Grid>
        <!-- Local: what the view holds, and Scan a folder for games… (LIB-22, LIB-23) -->
        <c:GsCard DockPanel.Dock="Top" Padding="16,12" Margin="0,0,0,16" IsVisible="{Binding IsLocalView}" AutomationProperties.Name="Games in their own folders">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
            <c:GsIcon Icon="folder" Size="18" Foreground="{DynamicResource ink-muted}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
              <TextBlock Classes="muted" FontSize="13" LineHeight="19" TextWrapping="Wrap"
                         Text="Games in their own folders, started without a store's launcher. GameSync finds them in the folders you give it, such as G:\ or E:\Games." />
              <TextBlock Classes="caption" Text="{Binding ScanNote}" TextWrapping="Wrap" IsVisible="{Binding HasScanNote}" />
            </StackPanel>
            <c:GsButton Grid.Column="2" Classes="sm" Icon="search" Content="{Binding ScanLabel}" Click="ScanFolder" VerticalAlignment="Center"
                        IsEnabled="{Binding !IsScanning}" IsVisible="{Binding CanScan}"
                        ToolTip.Tip="Pick a folder of games; GameSync looks in it now and at every scan" />
          </Grid>
        </c:GsCard>
        <!-- The covers' hover ring reaches 4px past each cover: the scroller gives it room on every side, so the first
             row's and column's rings aren't cut off, and the covers stay where they were. Its bar sits in the middle of
             the page's right gutter, clear of the covers and the window's edge, as every page scroller's does (KAN-71) -->
        <ScrollViewer Name="CoverScroller" HorizontalScrollBarVisibility="Disabled" Margin="-6,-6,-18,0" Padding="0,0,12,0">
          <StackPanel Spacing="12" Margin="6,6,6,8">
            <TextBlock Classes="caption faint" Text="{Binding Nothing}" TextWrapping="Wrap" IsVisible="{Binding HasNothing}" />
            <TextBlock Classes="overline faint" Text="FAVOURITES" IsVisible="{Binding HasFavouriteTiles}" />
            <ItemsControl ItemsSource="{Binding FavouriteTiles}" IsVisible="{Binding HasFavouriteTiles}" Margin="0,0,0,12" ClipToBounds="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <c:TilesPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TileItem">
                  <v:LibraryTile />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="overline faint" Text="{Binding OtherHeading, Converter={x:Static c:UpperConverter.Instance}}" IsVisible="{Binding HasFavouriteTiles}" />
            <ItemsControl ItemsSource="{Binding OtherTiles}" ClipToBounds="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <c:TilesPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TileItem">
                  <v:LibraryTile />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
      <ContentControl Content="{Binding Page}" IsVisible="{Binding !ShowsCovers}" />
    </Panel>
  </Grid>
</UserControl>
