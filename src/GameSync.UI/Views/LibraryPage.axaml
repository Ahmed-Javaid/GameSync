<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:GameSync.UI.Controls"
             xmlns:vm="using:GameSync.UI.ViewModels"
             x:Class="GameSync.UI.Views.LibraryPage"
             x:DataType="vm:LibraryViewModel">
  <!-- Every game as a cover tile (LIB-11): Steam's art, or a title cover, never an empty box. -->
  <DockPanel Margin="24,20">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,*" Margin="0,0,0,20">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{Binding Title}" FontSize="15" LineHeight="20" FontWeight="SemiBold" />
        <TextBlock Classes="caption faint" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <c:GsPillTabs Grid.Column="1" ItemsSource="{Binding Tabs}" SelectedId="{Binding SelectedTab, Mode=TwoWay}" />
      <c:GsButton Grid.Column="2" Icon="plus" Content="Add game" HorizontalAlignment="Right" />
    </Grid>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Tiles}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <c:ColumnsPanel Columns="7" Gap="16" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:TileItem">
            <c:GsGameTile Width="NaN" Title="{Binding Title}" Art="{Binding Art}" Status="{Binding Status}" Meta="{Binding Meta}">
              <c:GsGameTile.ContextMenu>
                <ContextMenu IsVisible="{Binding ToggleHidden, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <MenuItem Header="{Binding HideLabel}" Command="{Binding ToggleHidden}" />
                </ContextMenu>
              </c:GsGameTile.ContextMenu>
            </c:GsGameTile>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
