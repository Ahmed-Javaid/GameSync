<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:GameSync.UI.Controls"
             xmlns:vm="using:GameSync.UI.ViewModels"
             xmlns:v="using:GameSync.UI.Views"
             x:Class="GameSync.UI.Views.LibraryPage"
             x:DataType="vm:LibraryViewModel">
  <UserControl.Styles>
    <!-- The scan's notice: plain while it looks, in the primary colour once it has found something, in warn on a problem -->
    <Style Selector="Border.notice">
      <Setter Property="Background" Value="{DynamicResource bg-300}" />
      <Setter Property="BorderBrush" Value="{DynamicResource line-200}" />
    </Style>
    <Style Selector="Border.notice.done">
      <Setter Property="Background" Value="{DynamicResource primary-soft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource primary}" />
    </Style>
    <Style Selector="Border.notice.problem">
      <Setter Property="Background" Value="{DynamicResource warn-soft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource warn}" />
    </Style>
    <Style Selector="Border.notice Border.notice-mark">
      <Setter Property="Background" Value="{DynamicResource bg-400}" />
    </Style>
    <Style Selector="Border.notice.done Border.notice-mark">
      <Setter Property="Background" Value="{DynamicResource primary}" />
    </Style>
    <Style Selector="Border.notice.problem Border.notice-mark">
      <Setter Property="Background" Value="{DynamicResource bg-100}" />
    </Style>
  </UserControl.Styles>
  <!-- The game library, like Steam's (design system → LibraryScreen): every game by name in a list on the left, with the
       search, the sort and favourites first; the covers, or the page of the game picked, on the right. -->
  <Grid ColumnSpacing="16" Margin="24,20">
    <!-- The list grows a little with Windows' text size (A11Y-04) -->
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="{DynamicResource col-library-list}" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- The list -->
    <c:GsCard Padding="12" AutomationProperties.Name="Your games">
      <DockPanel>
        <TextBox Name="SearchBox" DockPanel.Dock="Top" Classes="search clearButton" PlaceholderText="Search your games"
                 Text="{Binding Search}" AutomationProperties.Name="Search your games">
          <TextBox.InnerLeftContent>
            <c:GsIcon Icon="search" Size="16" Margin="12,0,0,0" Foreground="{DynamicResource ink-faint}" VerticalAlignment="Center" />
          </TextBox.InnerLeftContent>
          <TextBox.InnerRightContent>
            <Panel VerticalAlignment="Center">
              <Border BorderBrush="{DynamicResource line-200}" BorderThickness="1" CornerRadius="4" Padding="5,0" Margin="0,0,8,0" VerticalAlignment="Center"
                      IsVisible="{Binding ShowsShortcut}">
                <TextBlock Text="Ctrl F" FontFamily="{DynamicResource font-mono}" FontSize="{DynamicResource fs-11}" LineHeight="{DynamicResource lh-16}" FontWeight="Medium" Foreground="{DynamicResource ink-faint}" />
              </Border>
              <!-- While searching, how many match, before the clear button -->
              <TextBlock Classes="caption faint" Text="{Binding SearchCount}" IsVisible="{Binding !ShowsShortcut}" Margin="0,0,4,0" VerticalAlignment="Center"
                         FontFamily="{DynamicResource font-mono}" />
            </Panel>
          </TextBox.InnerRightContent>
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding OpenFirstMatchCommand}" />
          </TextBox.KeyBindings>
        </TextBox>

        <!-- The view and the order, side by side (the owner, 18 Oct 2026: "Make it into a dropdown next to name"): each a
             dropdown; Installed or All games, and the order, are kept on this PC (LIB-31, LIB-16) -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" ColumnSpacing="4" Margin="0,10,0,6">
          <c:GsButton Classes="ghost sm tight trims" IconAfter="chevronDown" HorizontalAlignment="Left" AutomationProperties.Name="{Binding ViewName}"
                      ToolTip.Tip="Which games the list and the covers show">
            <TextBlock Text="{Binding ViewLabel}" TextTrimming="CharacterEllipsis" />
            <c:GsButton.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <c:GsMenuItem Header="Installed" Hint="{Binding InstalledCount}" ToggleType="CheckBox" IsChecked="{Binding ViewIsInstalled, Mode=OneWay}"
                              Command="{Binding ViewCommand}" CommandParameter="installed" />
                <c:GsMenuItem Header="Saves only" Hint="{Binding SavesCount}" ToggleType="CheckBox" IsChecked="{Binding ViewIsSaves, Mode=OneWay}"
                              Command="{Binding ViewCommand}" CommandParameter="saves" />
                <c:GsMenuItem Header="All games" Hint="{Binding AllCount}" ToggleType="CheckBox" IsChecked="{Binding ViewIsAll, Mode=OneWay}"
                              Command="{Binding ViewCommand}" CommandParameter="all" />
                <c:GsMenuItem Header="Local" Hint="{Binding LocalCount}" ToggleType="CheckBox" IsChecked="{Binding ViewIsLocal, Mode=OneWay}"
                              Command="{Binding ViewCommand}" CommandParameter="local" />
                <c:GsMenuItem Header="Software" Hint="{Binding SoftwareCount}" ToggleType="CheckBox" IsChecked="{Binding ViewIsSoftware, Mode=OneWay}"
                              Command="{Binding ViewCommand}" CommandParameter="software" IsVisible="{Binding HasSoftware}" />
                <c:GsMenuItem Header="Hidden" Hint="{Binding HiddenCount}" ToggleType="CheckBox" IsChecked="{Binding ViewIsHidden, Mode=OneWay}"
                              Command="{Binding ViewCommand}" CommandParameter="hidden" IsVisible="{Binding HasHidden}" />
              </MenuFlyout>
            </c:GsButton.Flyout>
          </c:GsButton>
          <c:GsButton Grid.Column="1" Classes="ghost sm tight trims" IconAfter="chevronDown" AutomationProperties.Name="{Binding SortName}"
                      ToolTip.Tip="The order of the list and the covers">
            <TextBlock Text="{Binding SortLabel}" TextTrimming="CharacterEllipsis" />
            <c:GsButton.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <c:GsMenuItem Header="Recently played" ToggleType="CheckBox" IsChecked="{Binding SortsByRecent, Mode=OneWay}"
                          Command="{Binding SortByCommand}" CommandParameter="RecentlyPlayed" />
                <c:GsMenuItem Header="Name" ToggleType="CheckBox" IsChecked="{Binding SortsByName, Mode=OneWay}"
                          Command="{Binding SortByCommand}" CommandParameter="Name" />
                <c:GsMenuItem Header="Hours played" ToggleType="CheckBox" IsChecked="{Binding SortsByHours, Mode=OneWay}"
                          Command="{Binding SortByCommand}" CommandParameter="HoursPlayed" />
                <c:GsMenuItem Header="Recently added" ToggleType="CheckBox" IsChecked="{Binding SortsByAdded, Mode=OneWay}"
                          Command="{Binding SortByCommand}" CommandParameter="RecentlyAdded" />
              </MenuFlyout>
            </c:GsButton.Flyout>
          </c:GsButton>
        </Grid>

        <ScrollViewer Name="ListScroller" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-8,0" Padding="0,0,8,0">
          <Panel>
            <TextBlock Classes="caption faint" Text="{Binding Nothing}" TextWrapping="Wrap" Margin="8,8" IsVisible="{Binding HasNothing}" />
            <ItemsControl Name="List" ItemsSource="{Binding ListItems}" KeyboardNavigation.TabNavigation="Once">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="2" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.DataTemplates>
                <DataTemplate DataType="vm:GameListHeading">
                  <c:GsListHeading Label="{Binding Label}" Count="{Binding CountText}" IsOpen="{Binding IsOpen}" Margin="0,8,0,0"
                                   AutomationProperties.Name="{Binding}"
                                   Command="{Binding $parent[v:LibraryPage].((vm:LibraryViewModel)DataContext).ToggleGroupCommand}"
                                   CommandParameter="{Binding GroupId}" />
                </DataTemplate>
                <DataTemplate DataType="vm:GameListRow">
                  <c:GsGameRow Title="{Binding Game.Title}" Art="{Binding Game.SmallArt}" Status="{Binding Game.Status}" StatusLabel="{Binding Game.StatusLabel}" MarkLabel="{Binding Game.MarkLabel}"
                               ShowsStatus="{Binding Game.ShowsListStatus}" IsInstalled="{Binding Game.Installed}"
                               AutomationProperties.Name="{Binding Game.SpokenName}" ToolTip.Tip="{Binding Game.SpokenName}"
                               Command="{Binding $parent[v:LibraryPage].((vm:LibraryViewModel)DataContext).OpenCommand}" CommandParameter="{Binding Game.Id}">
                    <c:GsGameRow.IsCurrent>
                      <MultiBinding Converter="{x:Static c:AllEqualConverter.Instance}">
                        <Binding Path="Game.Id" />
                        <Binding Path="$parent[v:LibraryPage].((vm:LibraryViewModel)DataContext).Selected" />
                      </MultiBinding>
                    </c:GsGameRow.IsCurrent>
                    <c:GsGameRow.ContextMenu>
                      <ContextMenu IsVisible="{Binding Game.HasMenu}">
                        <c:GsMenuItem Header="Play" Command="{Binding Game.PlayCommand}" IsVisible="{Binding Game.PlayCommand, Converter={x:Static ObjectConverters.IsNotNull}}">
                          <c:GsMenuItem.Icon><c:GsIcon Icon="play" Size="16" /></c:GsMenuItem.Icon>
                        </c:GsMenuItem>
                        <Separator IsVisible="{Binding Game.PlayCommand, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <c:GsMenuItem Header="{Binding Game.FavouriteLabel}" Command="{Binding Game.ToggleFavourite}">
                          <c:GsMenuItem.Icon><c:GsIcon Icon="star" Size="16" Filled="{Binding Game.IsFavourite}" /></c:GsMenuItem.Icon>
                        </c:GsMenuItem>
                        <c:GsMenuItem Header="{Binding Game.HideLabel}" Command="{Binding Game.ToggleHidden}" />
                        <Separator IsVisible="{Binding Game.HasProperties}" />
                        <c:GsMenuItem Header="Properties" Command="{Binding Game.PropertiesCommand}" IsVisible="{Binding Game.HasProperties}">
                          <c:GsMenuItem.Icon><c:GsIcon Icon="settings" Size="16" /></c:GsMenuItem.Icon>
                        </c:GsMenuItem>
                      </ContextMenu>
                    </c:GsGameRow.ContextMenu>
                  </c:GsGameRow>
                </DataTemplate>
              </ItemsControl.DataTemplates>
            </ItemsControl>
          </Panel>
        </ScrollViewer>
      </DockPanel>
    </c:GsCard>

    <!-- The covers, or the game picked -->
    <Panel Grid.Column="1">
      <DockPanel IsVisible="{Binding ShowsCovers}">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" ColumnSpacing="16" Margin="0,0,0,12">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" FontSize="{DynamicResource fs-15}" LineHeight="{DynamicResource lh-20}" FontWeight="SemiBold" />
            <TextBlock Classes="caption faint" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <!-- Add game folder (LIB-31): a folder of games, whose games the person picks in What's in it (LIB-30) -->
            <c:GsButton Icon="folder" Content="Add game folder" Click="ScanFolder" IsVisible="{Binding CanScan}"
                        IsEnabled="{Binding !IsScanning}" IsBusy="{Binding IsScanning}" BusyText="Scanning"
                        ToolTip.Tip="A folder your games are in: you pick which of what's inside are games" />
            <!-- Add game: a game or folder of the person's own (LIB-13), in its dialog -->
            <c:GsButton Icon="plus" Content="Add game" Command="{Binding AddGameCommand}" IsVisible="{Binding CanAddGame}"
                        ToolTip.Tip="One game GameSync didn't find, or a folder of your own such as a server's world" />
          </StackPanel>
        </Grid>
        <!-- What Add game folder or Scan a folder for games… is doing, found, or why it couldn't: a notice over the covers,
             in any view, until it's closed (the owner, 18 Oct 2026: "it need to be apparent that this is something we want you to see") -->
        <Border DockPanel.Dock="Top" Classes="notice" Classes.done="{Binding ScanNoteDone}" Classes.problem="{Binding ScanNoteProblem}"
                CornerRadius="{DynamicResource radius-lg}" BorderThickness="1" Padding="16,12" Margin="0,0,0,16" IsVisible="{Binding HasScanNote}"
                AutomationProperties.Name="{Binding ScanNote}" AutomationProperties.LiveSetting="Polite">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
            <Panel Width="32" Height="32" VerticalAlignment="Top">
              <Border Classes="notice-mark" CornerRadius="16" />
              <c:GsSpinner Size="18" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ScanNoteBusy}" />
              <c:GsIcon Icon="check" Size="18" StrokeWidth="2.4" Foreground="{DynamicResource on-primary}" HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsVisible="{Binding ScanNoteDone}" />
              <c:GsIcon Icon="alert" Size="18" StrokeWidth="2.2" Foreground="{DynamicResource warn}" HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsVisible="{Binding ScanNoteProblem}" />
            </Panel>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="{Binding ScanNote.Title, FallbackValue=''}" FontWeight="SemiBold" FontSize="{DynamicResource fs-14}" LineHeight="{DynamicResource lh-20}" TextWrapping="Wrap" />
              <TextBlock Classes="muted" Text="{Binding ScanNote.Detail, FallbackValue=''}" FontSize="{DynamicResource fs-13}" LineHeight="{DynamicResource lh-19}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <c:GsButton Classes="sm" Content="Show them" Command="{Binding ShowFoundCommand}" IsVisible="{Binding ScanNoteFound}"
                          ToolTip.Tip="The Local view: games in their own folders, which Play starts from there" />
              <c:GsIconButton Classes="sm" Icon="x" Label="Close this notice" Command="{Binding CloseScanNoteCommand}" IsVisible="{Binding !ScanNoteBusy}" />
            </StackPanel>
          </Grid>
        </Border>
        <!-- Saves only: games whose saves are here but that aren't installed on this PC (LIB-31) -->
        <c:GsCard DockPanel.Dock="Top" Padding="20,14" Margin="0,0,0,16" IsVisible="{Binding IsSavesView}" AutomationProperties.Name="Games whose saves are here">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
            <c:GsIcon Icon="saves" Size="18" Foreground="{DynamicResource ink-muted}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="muted" FontSize="{DynamicResource fs-13}" LineHeight="{DynamicResource lh-19}" TextWrapping="Wrap" VerticalAlignment="Center"
                       Text="Games whose saves are here but that aren't installed on this PC: kept from your other PCs or a friend's zip, or left by a game you uninstalled. Install one, and its saves are ready." />
          </Grid>
        </c:GsCard>
        <!-- Hidden: what the person hid, and what a later scan took for no game (LIB-30) -->
        <c:GsCard DockPanel.Dock="Top" Padding="20,14" Margin="0,0,0,16" IsVisible="{Binding IsHiddenView}" AutomationProperties.Name="Hidden from the launcher">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
            <c:GsIcon Icon="info" Size="18" Foreground="{DynamicResource ink-muted}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="muted" FontSize="{DynamicResource fs-13}" LineHeight="{DynamicResource lh-19}" TextWrapping="Wrap" VerticalAlignment="Center"
                       Text="Games you hid, and anything new in a game folder that doesn't look like a game, such as an app. Show in the launcher brings one back." />
          </Grid>
        </c:GsCard>
        <!-- Local: what the view holds, and Scan a folder for games… (LIB-22, LIB-23) -->
        <c:GsCard DockPanel.Dock="Top" Padding="16,12" Margin="0,0,0,16" IsVisible="{Binding IsLocalView}" AutomationProperties.Name="Games in their own folders">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
            <c:GsIcon Icon="folder" Size="18" Foreground="{DynamicResource ink-muted}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="muted" FontSize="{DynamicResource fs-13}" LineHeight="{DynamicResource lh-19}" TextWrapping="Wrap" VerticalAlignment="Center"
                       Text="Games in their own folders, started without a store's launcher. GameSync finds them in the folders you give it, such as G:\ or E:\Games." />
            <c:GsButton Grid.Column="2" Classes="sm" Icon="search" Content="{Binding ScanLabel}" Click="ScanFolder" VerticalAlignment="Center"
                        IsEnabled="{Binding !IsScanning}" IsVisible="{Binding CanScan}" IsBusy="{Binding IsScanning}" BusyText="Scanning"
                        ToolTip.Tip="Pick a folder of games; you choose which of what's inside are games, and GameSync looks in it at every scan" />
          </Grid>
        </c:GsCard>
        <!-- The covers' hover ring reaches 4px past each cover: the scroller gives it room on every side, so the first
             row's and column's rings aren't cut off, and the covers stay where they were. Its bar sits in the middle of
             the page's right gutter, clear of the covers and the window's edge, as every page scroller's does (KAN-71) -->
        <ScrollViewer Name="CoverScroller" HorizontalScrollBarVisibility="Disabled" Margin="-6,-6,-18,0" Padding="0,0,12,0">
          <StackPanel Spacing="12" Margin="6,6,6,8">
            <TextBlock Classes="caption faint" Text="{Binding Nothing}" TextWrapping="Wrap" IsVisible="{Binding HasNothing}" />
            <TextBlock Classes="overline faint" Text="FAVOURITES" IsVisible="{Binding HasFavouriteTiles}" />
            <ItemsControl Name="FavouriteCovers" ItemsSource="{Binding FavouriteTiles}" IsVisible="{Binding HasFavouriteTiles}" Margin="0,0,0,12" ClipToBounds="False"
                          KeyboardNavigation.TabNavigation="Once">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <c:TilesPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TileItem">
                  <v:LibraryTile />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="overline faint" Text="{Binding OtherHeading, Converter={x:Static c:UpperConverter.Instance}}" IsVisible="{Binding HasFavouriteTiles}" />
            <!-- A11Y-02: the covers are one Tab stop; the arrow keys go from cover to cover -->
            <ItemsControl Name="OtherCovers" ItemsSource="{Binding OtherTiles}" ClipToBounds="False" KeyboardNavigation.TabNavigation="Once">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <c:TilesPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TileItem">
                  <v:LibraryTile />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
      <!-- A game's page, or its achievements, every one, over it -->
      <ContentControl Content="{Binding Shown}" IsVisible="{Binding !ShowsCovers}" />
    </Panel>
  </Grid>
</UserControl>
