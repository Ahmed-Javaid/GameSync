<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AssemblyName>gamesync</AssemblyName>
    <RootNamespace>GameSync.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameSync.Host\GameSync.Host.csproj" />
    <!-- Only so GameSync.Tray.exe, the background app, is built next to gamesync.exe; "schedule" points Windows at it. -->
    <ProjectReference Include="..\GameSync.Tray\GameSync.Tray.csproj" />
  </ItemGroup>

</Project>
